fun needs_arg -> bool numeric op;
    if op == OP_PUSH;
        return true
    elif op == OP_JMP;
        return true
    elif op == OP_JZ;
        return true
    elif op == OP_JNZ;
        return true
    elif op == OP_LOAD;
        return true
    elif op == OP_STORE;
        return true
    elif op == OP_CALL;
        return true
    elif op == OP_ARG;
        return true
    elif op == OP_PUSHS;
        return true
    elif op == OP_INPUT;
        return true
    elif op == OP_INPUTN;
        return true
    elif op == OP_ASSERT;
        return true
    elif op == OP_NEWARR;
        return true
    elif op == OP_FOPEN;
        return true
    break
    return false
break


fun parse_quoted -> text text s;
    text t = trim_left(s)
    if length(t) == 0;
        return ""
    break
    if t[0] != "\"";
        return ""
    break
    text out = ""
    numeric i = 1
    numeric n = length(t)
    numeric ok = 0
    while i < n;
        text c = t[i]
        if c == "\\";
            i = i + 1
            if i < n;
                text e = t[i]
                if e == "n";
                    out = out + "\n"
                elif e == "t";
                    out = out + "\t"
                elif e == "\\";
                    out = out + "\\"
                elif e == "\"";
                    out = out + "\""
                else;
                    out = out + e
                break
            break
        elif c == "\"";
            ok = 1
            i = n
        else;
            out = out + c
        break
        i = i + 1
    break
    if ok == 0;
        return ""
    break
    return out
break

fun has_closing_quote -> bool text s;
    text t = trim_left(s)
    if length(t) < 2;
        return false
    break
    if t[0] != "\"";
        return false
    break
    numeric i = 1
    numeric n = length(t)
    while i < n;
        text c = t[i]
        if c == "\\";
            i = i + 1
        elif c == "\"";
            return true
        break
        i = i + 1
    break
    return false
break

fun intern_str -> numeric text s;
    strpool.append(s)
    numeric id = str_count
    str_count = str_count + 1
    return id
break

fun clear_program -> bool;
    code_len = 0
    opt_len = 0
    sp = 0
    fp = 0
    csp = 0
    ip = 0
    last_exit = 0
    opt_removed = 0
    src_lines = []
    xc = []
    strpool = []
    str_count = 0
    labnames = []
    numeric li0 = 0
    while li0 < LAB_MAX;
        labnames.append("")
        li0 = li0 + 1
    break
    arr_pool = []
    file_pool = []
    arr_count = 0
    file_count = 0
    numeric i = 0
    while i < LAB_MAX;
        p#write(labtab, i, 0 - 1)
        p#write(labused, i, 0)
        p#write(labkey, i, 0)
        p#write(constset, i, 0)
        p#write(consttab, i, 0)
        p#write(constkey, i, 0)
        i = i + 1
    break
    return true
break

fun load_source -> bool text path;
    current_file = path
    if file_exists(path) == false;
        log ""
        log "========================================"
        log "  ERROR: archivo no encontrado"
        log "========================================"
        log "No existe: " + path
        log "Pegassus busca en este orden:"
        log "  1) la ruta tal cual"
        log "  2) nombre.ir en el directorio actual"
        log "  3) examples/nombre.ir"
        log "Prueba:  pegassus examples   o   pegassus run hello"
        log "========================================"
        return false
    break
    file f = open(path)
    text all = read(f)
    close(f)
    text cur = ""
    numeric i = 0
    numeric n = length(all)
    numeric h = 5381
    while i < n;
        text c = all[i]
        numeric cc = char_code(c)
        h = h * 33 + cc
        if h < 0;
            h = 0 - h
        break
        h = h % 1000000007
        if c == "\n";
            src_lines.append(cur)
            cur = ""
            i = i + 1
        else;
            if c != "\r";
                cur = cur + c
            break
            i = i + 1
        break
    break
    if length(cur) > 0;
        src_lines.append(cur)
    break
    list expanded = []
    numeric ei = 0
    while ei < length(src_lines);
        text rawl = src_lines[ei]
        text tl = trim_left(strip_comment(rawl))
        text fw = first_word(tl)
                if fw == "include";
            text incp = first_word(rest_words(tl))
            if length(incp) == 0;
                err_asm("include sin ruta (uso: include otro.ir)", ei + 1)
                return false
            break
            text ipath = resolve_path(incp)
            if file_exists(ipath) == false;
                text base = path_dir(current_file)
                if length(base) > 0;
                    text rel = base + incp
                    if file_exists(rel);
                        ipath = rel
                    break
                break
            break
            if file_exists(ipath) == false;
                err_asm("include no encontrado: " + incp, ei + 1)
                return false
            break
            file fi = open(ipath)
            text iall = read(fi)
            close(fi)
            text icur = ""
            numeric ii = 0
            numeric in2 = length(iall)
            while ii < in2;
                text ic = iall[ii]
                if ic == "\n";
                    expanded.append(icur)
                    icur = ""
                elif ic != "\r";
                    icur = icur + ic
                break
                ii = ii + 1
            break
            if length(icur) > 0;
                expanded.append(icur)
            break
        else;
            expanded.append(rawl)
        break
        ei = ei + 1
    break
    src_lines = expanded
    src_hash = h % 1000000007
    return true
break

fun assemble -> bool;
    numeric li = 0
    numeric nlines = length(src_lines)
    numeric addr = 0
    while li < nlines;
        cur_src_line = li + 1
        text line = trim_left(strip_comment(src_lines[li]))
        if length(line) > 0;
            text w = first_word(line)
            if w == "lab";
                text idt = rest_words(line)
                if length(idt) == 0;
                    err_asm("falta el nombre o id tras 'lab'", li + 1)
                    return false
                break
                text lname = first_word(idt)
                numeric prev = lab_get(lname)
                if prev >= 0;
                    if prev != addr;
                        err_asm("etiqueta redefinida: '" + lname + "'", li + 1)
                        return false
                    break
                break
                if lab_set(lname, addr) == false;
                    return false
                break
            elif w == "const";
                text rest = rest_words(line)
                text cname = first_word(rest)
                text cval = rest_words(rest)
                if length(cname) == 0;
                    err_asm("uso: const NOMBRE VALOR", li + 1)
                    return false
                break
                if is_number_token(cval) == false;
                    err_asm("const VALOR debe ser numero o 0xHEX", li + 1)
                    return false
                break
                const_set(name_id(cname), parse_num(cval))
            else;
                numeric op = opcode_of(w)
                if op < 0;
                    err_asm("no conozco la instruccion '" + w + "'. ¿Typo? Lista en: pegassus cmds", li + 1)
                    return false
                break
                addr = addr + 1
                if needs_arg(op);
                    addr = addr + 1
                break
            break
        break
        li = li + 1
    break

    li = 0
    while li < nlines;
        cur_src_line = li + 1
        text line2 = trim_left(strip_comment(src_lines[li]))
        if length(line2) > 0;
            text w2 = first_word(line2)
            if w2 != "lab";
                if w2 != "const";
                    numeric op2 = opcode_of(w2)
                    if needs_arg(op2);
                        text argt = first_word(rest_words(line2))
                        text argrest = rest_words(line2)
                        if op2 == OP_PUSHS;
                            argt = argrest
                        elif op2 == OP_ASSERT;
                            argt = argrest
                        elif op2 == OP_FOPEN;
                            argt = argrest
                        elif op2 == OP_INPUT;
                            argt = argrest
                        elif op2 == OP_INPUTN;
                            argt = argrest
                        break
                        if length(argt) == 0;
                            if op2 == OP_INPUT;
                            elif op2 == OP_INPUTN;
                            else;
                                err_asm("'" + w2 + "' necesita argumento", li + 1)
                                return false
                            break
                        break
                        if op2 == OP_PUSH;
                            numeric pv = resolve_value(argt)
                            if pv == 0 - 999999999;
                                err_asm("push espera numero, 0xHEX o const definido. '" + argt + "' no vale. Ej: const X 10  luego push X", li + 1)
                                return false
                            break
                            emit2(op2, pv)
                        elif op2 == OP_LOAD;
                            numeric lv = resolve_value(argt)
                            if lv == 0 - 999999999;
                                err_asm("load: slot invalido '" + argt + "'", li + 1)
                                return false
                            break
                            if lv < 0;
                                err_asm("load: slot < 0", li + 1)
                                return false
                            break
                            if lv >= LOCAL_MAX;
                                err_asm("load: slot local invalido (rango 0..131071, LOCAL_MAX=131072, locals=1MiB)", li + 1)
                                return false
                            break
                            emit2(op2, lv)
                        elif op2 == OP_STORE;
                            numeric sv = resolve_value(argt)
                            if sv == 0 - 999999999;
                                err_asm("store: slot invalido '" + argt + "'", li + 1)
                                return false
                            break
                            if sv < 0;
                                err_asm("store: slot < 0", li + 1)
                                return false
                            break
                            if sv >= LOCAL_MAX;
                                err_asm("store: slot fuera de rango (0 .. LOCAL_MAX-1 = 131071)", li + 1)
                                return false
                            break
                            emit2(op2, sv)
                        elif op2 == OP_ARG;
                            if is_number_token(argt) == false;
                                err_asm("arg espera indice numerico", li + 1)
                                return false
                            break
                            emit2(op2, parse_num(argt))
                        elif op2 == OP_PUSHS;
                            if has_closing_quote(argt) == false;
                                err_asm("pushs espera \"texto\" entre comillas", li + 1)
                                return false
                            break
                            emit2(op2, intern_str(parse_quoted(argt)))
                        elif op2 == OP_ASSERT;
                            if has_closing_quote(argt) == false;
                                err_asm("assert espera \"mensaje\" entre comillas", li + 1)
                                return false
                            break
                            emit2(op2, intern_str(parse_quoted(argt)))
                        elif op2 == OP_FOPEN;
                            if has_closing_quote(argt) == false;
                                err_asm("fopen espera \"ruta\" entre comillas", li + 1)
                                return false
                            break
                            emit2(op2, intern_str(parse_quoted(argt)))
                        elif op2 == OP_NEWARR;
                            if is_number_token(argt) == false;
                                err_asm("newarr espera tamaño numerico", li + 1)
                                return false
                            break
                            emit2(op2, parse_num(argt))
                        elif op2 == OP_INPUT;
                            if length(argt) == 0;
                                emit2(op2, intern_str(""))
                            elif has_closing_quote(argt) == false;
                                err_asm("input espera \"pregunta\" entre comillas", li + 1)
                                return false
                            else;
                                emit2(op2, intern_str(parse_quoted(argt)))
                            break
                        elif op2 == OP_INPUTN;
                            if length(argt) == 0;
                                emit2(op2, intern_str(""))
                            elif has_closing_quote(argt) == false;
                                err_asm("inputn espera \"pregunta\" entre comillas", li + 1)
                                return false
                            else;
                                emit2(op2, intern_str(parse_quoted(argt)))
                            break
                        elif op2 == OP_JMP;
                            numeric ta = lab_get(argt)
                            if ta < 0;
                                err_asm("saltas a '" + argt + "' pero no hay lab " + argt + ". Añade esa etiqueta en el archivo (el ensamblador usa 2 pasadas).", li + 1)
                                return false
                            break
                            emit2(op2, ta)
                        elif op2 == OP_JZ;
                            numeric ta2 = lab_get(argt)
                            if ta2 < 0;
                                err_asm("la etiqueta '" + argt + "' no existe. Añade: lab " + argt, li + 1)
                                return false
                            break
                            emit2(op2, ta2)
                        elif op2 == OP_JNZ;
                            numeric ta3 = lab_get(argt)
                            if ta3 < 0;
                                err_asm("la etiqueta '" + argt + "' no existe. Añade: lab " + argt, li + 1)
                                return false
                            break
                            emit2(op2, ta3)
                        elif op2 == OP_CALL;
                            numeric ta4 = lab_get(argt)
                            if ta4 < 0;
                                err_asm("call a '" + argt + "' sin lab " + argt + ". Pon lab donde empiece la rutina.", li + 1)
                                return false
                            break
                            emit2(op2, ta4)
                        break
                    else;
                        emit1(op2)
                    break
                break
            break
        break
        li = li + 1
    break
    cur_src_line = 0
    emit1(OP_HALT)
    if check_stack_static() == false;
        return false
    break
    return true
break


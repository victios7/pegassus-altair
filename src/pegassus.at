fun is_space_char -> bool text c;
    if c == " ";
        return true
    break
    if c == "\t";
        return true
    break
    if c == "\r";
        return true
    break
    return false
break

fun trim_left -> text text s;
    numeric i = 0
    numeric n = length(s)
    numeric started = 0
    text out = ""
    while i < n;
        text c = s[i]
        if started == 0;
            if is_space_char(c);
                i = i + 1
            break
            if is_space_char(c) == false;
                started = 1
            break
        break
        if started == 1;
            out = out + c
            i = i + 1
        break
    break
    return out
break

fun strip_comment -> text text s;
    numeric i = 0
    numeric n = length(s)
    text out = ""
    numeric done = 0
    while i < n;
        if done == 0;
            text c = s[i]
            if c == ";";
                done = 1
            break
            if c != ";";
                out = out + c
                i = i + 1
            break
        break
        if done == 1;
            i = n
        break
    break
    return out
break

fun digit_val -> numeric text c;
    if c == "0";
        return 0
    elif c == "1";
        return 1
    elif c == "2";
        return 2
    elif c == "3";
        return 3
    elif c == "4";
        return 4
    elif c == "5";
        return 5
    elif c == "6";
        return 6
    elif c == "7";
        return 7
    elif c == "8";
        return 8
    elif c == "9";
        return 9
    elif c == "a";
        return 10
    elif c == "b";
        return 11
    elif c == "c";
        return 12
    elif c == "d";
        return 13
    elif c == "e";
        return 14
    elif c == "f";
        return 15
    elif c == "A";
        return 10
    elif c == "B";
        return 11
    elif c == "C";
        return 12
    elif c == "D";
        return 13
    elif c == "E";
        return 14
    elif c == "F";
        return 15
    break
    return 0 - 1
break

fun is_digits -> bool text s;
    numeric n = length(s)
    if n == 0;
        return false
    break
    numeric i = 0
    if s[0] == "-";
        if n == 1;
            return false
        break
        i = 1
    break
    numeric ok = 1
    while i < n;
        numeric d = digit_val(s[i])
        if d < 0;
            ok = 0
            i = n
        elif d > 9;
            ok = 0
            i = n
        else;
            i = i + 1
        break
    break
    if ok == 1;
        return true
    break
    return false
break

fun is_hex -> bool text s;
    numeric n = length(s)
    if n < 3;
        return false
    break
    if s[0] != "0";
        return false
    break
    if s[1] != "x";
        if s[1] != "X";
            return false
        break
    break
    numeric i = 2
    numeric ok = 1
    if i >= n;
        return false
    break
    while i < n;
        numeric d = digit_val(s[i])
        if d < 0;
            ok = 0
            i = n
        else;
            i = i + 1
        break
    break
    if ok == 1;
        return true
    break
    return false
break

fun parse_num -> numeric text s;
    if is_hex(s);
        numeric n = length(s)
        numeric i = 2
        numeric v = 0
        while i < n;
            v = v * 16 + digit_val(s[i])
            i = i + 1
        break
        return v
    break
    numeric n2 = length(s)
    numeric i2 = 0
    numeric sign = 1
    numeric v2 = 0
    if n2 > 0;
        if s[0] == "-";
            sign = 0 - 1
            i2 = 1
        break
    break
    while i2 < n2;
        v2 = v2 * 10 + digit_val(s[i2])
        i2 = i2 + 1
    break
    return v2 * sign
break

fun is_number_token -> bool text s;
    if is_digits(s);
        return true
    break
    if is_hex(s);
        return true
    break
    return false
break

fun first_word -> text text s;
    text w = ""
    numeric i = 0
    numeric n = length(s)
    numeric done = 0
    while i < n;
        if done == 0;
            text c = s[i]
            if is_space_char(c);
                done = 1
            else;
                w = w + c
                i = i + 1
            break
        else;
            i = n
        break
    break
    return w
break

fun rest_words -> text text s;
    numeric i = 0
    numeric n = length(s)
    numeric phase = 0
    while i < n;
        if phase == 0;
            if is_space_char(s[i]);
                phase = 1
            else;
                i = i + 1
            break
        elif phase == 1;
            if is_space_char(s[i]);
                i = i + 1
            else;
                phase = 2
            break
        else;
            text out = ""
            numeric j = i
            while j < n;
                out = out + s[j]
                j = j + 1
            break
            return out
        break
    break
    return ""
break

fun second_word -> text text s;
    return first_word(rest_words(s))
break

fun third_word -> text text s;
    return first_word(rest_words(rest_words(s)))
break

fun char_code -> numeric text c;
    numeric d = digit_val(c)
    if d >= 0;
        return d
    break
    if c == "_";
        return 36
    elif c == "g";
        return 16
    elif c == "h";
        return 17
    elif c == "i";
        return 18
    elif c == "j";
        return 19
    elif c == "k";
        return 20
    elif c == "l";
        return 21
    elif c == "m";
        return 22
    elif c == "n";
        return 23
    elif c == "o";
        return 24
    elif c == "p";
        return 25
    elif c == "q";
        return 26
    elif c == "r";
        return 27
    elif c == "s";
        return 28
    elif c == "t";
        return 29
    elif c == "u";
        return 30
    elif c == "v";
        return 31
    elif c == "w";
        return 32
    elif c == "x";
        return 33
    elif c == "y";
        return 34
    elif c == "z";
        return 35
    elif c == "G";
        return 16
    elif c == "H";
        return 17
    elif c == "I";
        return 18
    elif c == "J";
        return 19
    elif c == "K";
        return 20
    elif c == "L";
        return 21
    elif c == "M";
        return 22
    elif c == "N";
        return 23
    elif c == "O";
        return 24
    elif c == "P";
        return 25
    elif c == "Q";
        return 26
    elif c == "R";
        return 27
    elif c == "S";
        return 28
    elif c == "T";
        return 29
    elif c == "U";
        return 30
    elif c == "V";
        return 31
    elif c == "W";
        return 32
    elif c == "X";
        return 33
    elif c == "Y";
        return 34
    elif c == "Z";
        return 35
    break
    return 37
break

fun name_id -> numeric text s;
    if is_digits(s);
        return parse_num(s)
    break
    numeric h = 2166136261
    numeric i = 0
    numeric n = length(s)
    while i < n;
        h = h * 16777619
        h = h + char_code(s[i])
        if h < 0;
            h = 0 - h
        break
        i = i + 1
    break
    if h < 0;
        h = 0 - h
    break
    if h == 0;
        h = 1
    break
    return h
break

fun ends_with_ir -> bool text s;
    numeric n = length(s)
    if n < 3;
        return false
    break
    if s[n - 3] == ".";
        if s[n - 2] == "i";
            if s[n - 1] == "r";
                return true
            break
        break
    break
    return false
break

fun path_dir -> text text path;
    numeric n = length(path)
    numeric last = 0 - 1
    numeric i = 0
    while i < n;
        text c = path[i]
        if c == "/";
            last = i
        break
        if c == "\\";
            last = i
        break
        i = i + 1
    break
    if last < 0;
        return ""
    break
    text d = ""
    i = 0
    while i <= last;
        d = d + path[i]
        i = i + 1
    break
    return d
break

fun resolve_path -> text text name;
    if ends_with_ir(name);
        if file_exists(name);
            return name
        break
        text c = "examples/" + name
        if file_exists(c);
            return c
        break
        return name
    break
    if file_exists(name);
        return name
    break
    text a = name + ".ir"
    if file_exists(a);
        return a
    break
    text b = "examples/" + name + ".ir"
    if file_exists(b);
        return b
    break
    return a
break

fun src_at_ip -> numeric numeric at;
    if at < 0;
        return 0
    break
    if at >= code_len;
        return 0
    break
    return p#read(codeline, at)
break

fun err_rt -> bool text msg, numeric at, numeric r_sp, numeric r_fp, numeric r_csp;
    numeric ln = src_at_ip(at)
    log ""
    log "========================================"
    log "  ERROR EN TIEMPO DE EJECUCION (Pegassus)"
    log "========================================"
    log "Que paso:"
    log "  " + msg
    log ""
    log "Donde:"
    log "  archivo:      " + current_file
    if ln > 0;
        log "  linea fuente: " + ln
        if ln <= length(src_lines);
            log "  codigo:       " + src_lines[ln - 1]
        break
    else;
        log "  linea fuente: (desconocida)"
    break
    log "  ip bytecode:  " + at
    log ""
    log "Estado de la VM:"
    log "  profundidad pila (sp): " + r_sp + " / " + STACK_MAX
    log "  frame pointer (fp):    " + r_fp
    log "  profundidad calls:     " + r_csp + " / " + CALL_MAX
    log "  limites: STACK_MAX=" + STACK_MAX + " LOCAL_MAX=" + LOCAL_MAX + " (1 MiB cada uno)"
    log ""
    log "Pistas:"
    log "  - underflow: faltan push / sobran pop o print"
    log "  - local fuera de rango: usa slots 0.." + (LOCAL_MAX - 1)
    log "  - ABI libs tipica: args en 240-249, temps 250-255"
    log "  - pegassus dis <prog>   |  pegassus check <prog>  |  pegassus trace <prog>"
    log "========================================"
    return false
break

fun err_asm -> bool text msg, numeric ln;
    log ""
    log "========================================"
    log "  ERROR AL ENSAMBLAR (Pegassus IR)"
    log "========================================"
    log "Que paso:"
    log "  " + msg
    log ""
    log "Donde:"
    log "  archivo: " + current_file
    log "  linea:   " + ln
    if ln > 0;
        if ln <= length(src_lines);
            log "  codigo:  " + src_lines[ln - 1]
        break
    break
    log ""
    log "Sintaxis valida (resumen):"
    log "  const NOMBRE 123     o  const NOMBRE 0xff"
    log "  lab nombre           o  lab 1"
    log "  push 10 | push NOMBRE | push 0x2a"
    log "  jmp nombre | jz nombre | call nombre"
    log "  print | pushs \"hi\" | prints | input \"?\" | inputn \"n:\" | end"
    log ""
    log "Ayuda:  pegassus help  |  pegassus cmds  |  pegassus examples"
    log "========================================"
    return false
break

fun lab_slot -> numeric text name;
    numeric key = name_id(name)
    numeric k2 = key
    if k2 < 0;
        k2 = 0 - k2
    break
    numeric start = k2 % LAB_MAX
    numeric i = 0
    while i < LAB_MAX;
        numeric idx = (start + i) % LAB_MAX
        if p#read(labused, idx) == 0;
            return idx
        break
        if idx < length(labnames);
            if labnames[idx] == name;
                return idx
            break
        break
        i = i + 1
    break
    return 0 - 1
break

fun lab_get -> numeric text name;
    numeric key = name_id(name)
    numeric k2 = key
    if k2 < 0;
        k2 = 0 - k2
    break
    numeric start = k2 % LAB_MAX
    numeric i = 0
    while i < LAB_MAX;
        numeric idx = (start + i) % LAB_MAX
        if p#read(labused, idx) == 0;
            return 0 - 1
        break
        if idx < length(labnames);
            if labnames[idx] == name;
                return p#read(labtab, idx)
            break
        break
        i = i + 1
    break
    return 0 - 1
break

fun lab_set -> bool text name, numeric addr;
    numeric idx = lab_slot(name)
    if idx < 0;
        log "error: tabla de etiquetas llena (limite " + LAB_MAX + " nombres distintos)"
        return false
    break
    numeric k2 = name_id(name)
    if k2 < 0;
        k2 = 0 - k2
    break
    p#write(labkey, idx, k2)
    p#write(labused, idx, 1)
    p#write(labtab, idx, addr)
    while length(labnames) <= idx;
        labnames.append("")
    break
    labnames[idx] = name
    return true
break

fun const_slot -> numeric numeric key;
    numeric k2 = key
    if k2 < 0;
        k2 = 0 - k2
    break
    numeric start = k2 % LAB_MAX
    numeric i = 0
    while i < LAB_MAX;
        numeric idx = (start + i) % LAB_MAX
        if p#read(constset, idx) == 0;
            return idx
        break
        if p#read(constkey, idx) == k2;
            return idx
        break
        i = i + 1
    break
    return 0 - 1
break

fun const_get -> numeric numeric id;
    numeric idx = const_slot(id)
    if idx < 0;
        return 0
    break
    if p#read(constset, idx) == 0;
        return 0
    break
    return p#read(consttab, idx)
break

fun const_has -> bool numeric id;
    numeric idx = const_slot(id)
    if idx < 0;
        return false
    break
    if p#read(constset, idx) == 1;
        return true
    break
    return false
break

fun const_set -> bool numeric id, numeric val;
    numeric idx = const_slot(id)
    if idx < 0;
        log "error: tabla de constantes llena (limite " + LAB_MAX + " nombres distintos)"
        return false
    break
    numeric k2 = id
    if k2 < 0;
        k2 = 0 - k2
    break
    p#write(constkey, idx, k2)
    p#write(consttab, idx, val)
    p#write(constset, idx, 1)
    return true
break

fun resolve_value -> numeric text tok;
    if is_number_token(tok);
        return parse_num(tok)
    break
    numeric id = name_id(tok)
    if const_has(id);
        return const_get(id)
    break
    return 0 - 999999999
break

fun emit1 -> bool numeric op;
    if code_len >= CODE_MAX;
        log "error: programa demasiado grande"
        return false
    break
    p#write(code, code_len, op)
    p#write(codeline, code_len, cur_src_line)
    code_len = code_len + 1
    return true
break

fun emit2 -> bool numeric op, numeric a;
    if code_len + 1 >= CODE_MAX;
        log "error: programa demasiado grande"
        return false
    break
    p#write(code, code_len, op)
    p#write(codeline, code_len, cur_src_line)
    p#write(code, code_len + 1, a)
    p#write(codeline, code_len + 1, cur_src_line)
    code_len = code_len + 2
    return true
break


fun check_stack_static -> bool;
    numeric depth = 0
    numeric known = 1
    numeric i = 0
    while i < code_len;
        numeric op = p#read(code, i)
        numeric ln = p#read(codeline, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        numeric need = stack_need(op)
        if known == 1;
            if depth < need;
                text on = op_name(op)
                err_asm("pila insuficiente para '" + on + "': necesita " + need + " valor(es) y solo hay " + depth + ". Falta push/load antes de esta instruccion.", ln)
                return false
            break
            depth = depth - need + stack_prod(op)
            if depth < 0;
                depth = 0
            break
        break
        if op == OP_JMP;
            known = 0
            depth = 0
        elif op == OP_CALL;
            known = 0
            depth = 0
        elif op == OP_RET;
            known = 0
            depth = 0
        elif op == OP_JZ;
            if known == 1;
            break
        elif op == OP_JNZ;
            if known == 1;
            break
        elif op == OP_HALT;
            known = 0
            depth = 0
        elif op == OP_HALTC;
            known = 0
            depth = 0
        break
        i = i + w + 1
    break
    return true
break

fun verify_bytecode -> bool;
    if opt_len < 1;
        log "error: bytecode vacio"
        return false
    break
    if opt_len >= CODE_MAX;
        log "error: bytecode demasiado grande"
        return false
    break
    numeric i = 0
    while i < opt_len;
        p#write(boundary, i, 0)
        i = i + 1
    break
    i = 0
    while i < opt_len;
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            log "error: opcode invalido en bytecode, offset " + i + ": " + op
            return false
        break
        p#write(boundary, i, 1)
        if i + w >= opt_len;
            if w > 0;
                log "error: operandos truncados para opcode " + op + " en offset " + i
                return false
            break
        break
        i = i + w + 1
    break
    i = 0
    while i < opt_len;
        numeric op2 = p#read(optc, i)
        numeric w2 = opcode_width(op2)
        if w2 < 0;
            return false
        break
        if op2 == OP_LOAD;
            numeric slot = p#read(optc, i + 1)
            if slot < 0;
                log "error: local negativo en LOAD"
                return false
            break
            if slot >= LOCAL_MAX;
                log "error: local fuera de rango en LOAD: " + slot
                return false
            break
        elif op2 == OP_STORE;
            numeric slot2 = p#read(optc, i + 1)
            if slot2 < 0;
                log "error: local negativo en STORE"
                return false
            break
            if slot2 >= LOCAL_MAX;
                log "error: local fuera de rango en STORE: " + slot2
                return false
            break
        elif op2 == OP_JMP;
            numeric t0 = p#read(optc, i + 1)
            if t0 < 0;
                log "error: salto negativo en JMP"
                return false
            break
            if t0 >= opt_len;
                log "error: destino fuera de rango en JMP: " + t0
                return false
            break
            if p#read(boundary, t0) != 1;
                log "error: JMP cae dentro de otra instruccion: " + t0
                return false
            break
        elif op2 == OP_JZ;
            numeric t1 = p#read(optc, i + 1)
            if t1 < 0;
                log "error: salto negativo en JZ"
                return false
            break
            if t1 >= opt_len;
                log "error: destino fuera de rango en JZ: " + t1
                return false
            break
            if p#read(boundary, t1) != 1;
                log "error: JZ cae dentro de otra instruccion: " + t1
                return false
            break
        elif op2 == OP_JNZ;
            numeric t2 = p#read(optc, i + 1)
            if t2 < 0;
                log "error: salto negativo en JNZ"
                return false
            break
            if t2 >= opt_len;
                log "error: destino fuera de rango en JNZ: " + t2
                return false
            break
            if p#read(boundary, t2) != 1;
                log "error: JNZ cae dentro de otra instruccion: " + t2
                return false
            break
        elif op2 == OP_CALL;
            numeric tc = p#read(optc, i + 1)
            if tc < 0;
                log "error: CALL negativo"
                return false
            break
            if tc >= opt_len;
                log "error: destino fuera de rango en CALL: " + tc
                return false
            break
            if p#read(boundary, tc) != 1;
                log "error: CALL cae dentro de otra instruccion: " + tc
                return false
            break
        elif op2 == OP_JLE_LN;
            numeric sl0 = p#read(optc, i + 1)
            numeric tl0 = p#read(optc, i + 3)
            if sl0 < 0;
                return false
            break
            if sl0 >= LOCAL_MAX;
                log "error: local fuera de rango en JLE_LN"
                return false
            break
            if tl0 < 0;
                return false
            break
            if tl0 >= opt_len;
                return false
            break
            if p#read(boundary, tl0) != 1;
                log "error: JLE_LN cae dentro de otra instruccion"
                return false
            break
        elif op2 == OP_JGT_LN;
            numeric sl1 = p#read(optc, i + 1)
            numeric tl1 = p#read(optc, i + 3)
            if sl1 < 0;
                return false
            break
            if sl1 >= LOCAL_MAX;
                log "error: local fuera de rango en JGT_LN"
                return false
            break
            if tl1 < 0;
                return false
            break
            if tl1 >= opt_len;
                return false
            break
            if p#read(boundary, tl1) != 1;
                log "error: JGT_LN cae dentro de otra instruccion"
                return false
            break
        elif op2 == OP_JLT_LN;
            numeric sl2 = p#read(optc, i + 1)
            numeric tl2 = p#read(optc, i + 3)
            if sl2 < 0;
                return false
            break
            if sl2 >= LOCAL_MAX;
                log "error: local fuera de rango en JLT_LN"
                return false
            break
            if tl2 < 0;
                return false
            break
            if tl2 >= opt_len;
                return false
            break
            if p#read(boundary, tl2) != 1;
                log "error: JLT_LN cae dentro de otra instruccion"
                return false
            break
        elif op2 == OP_JGE_LN;
            numeric sl3 = p#read(optc, i + 1)
            numeric tl3 = p#read(optc, i + 3)
            if sl3 < 0;
                return false
            break
            if sl3 >= LOCAL_MAX;
                log "error: local fuera de rango en JGE_LN"
                return false
            break
            if tl3 < 0;
                return false
            break
            if tl3 >= opt_len;
                return false
            break
            if p#read(boundary, tl3) != 1;
                log "error: JGE_LN cae dentro de otra instruccion"
                return false
            break
        elif op2 == OP_JZ_L;
            numeric sl4 = p#read(optc, i + 1)
            numeric tl4 = p#read(optc, i + 2)
            if sl4 < 0;
                return false
            break
            if sl4 >= LOCAL_MAX;
                log "error: local fuera de rango en JZ_L"
                return false
            break
            if tl4 < 0;
                return false
            break
            if tl4 >= opt_len;
                return false
            break
            if p#read(boundary, tl4) != 1;
                log "error: JZ_L cae dentro de otra instruccion"
                return false
            break
        elif op2 == OP_JNZ_L;
            numeric sl5 = p#read(optc, i + 1)
            numeric tl5 = p#read(optc, i + 2)
            if sl5 < 0;
                return false
            break
            if sl5 >= LOCAL_MAX;
                log "error: local fuera de rango en JNZ_L"
                return false
            break
            if tl5 < 0;
                return false
            break
            if tl5 >= opt_len;
                return false
            break
            if p#read(boundary, tl5) != 1;
                log "error: JNZ_L cae dentro de otra instruccion"
                return false
            break
        elif op2 == OP_IADD_LL;
            numeric x0 = p#read(optc, i + 1)
            numeric y0 = p#read(optc, i + 2)
            if x0 < 0;
                return false
            break
            if x0 >= LOCAL_MAX;
                return false
            break
            if y0 < 0;
                return false
            break
            if y0 >= LOCAL_MAX;
                return false
            break
        elif op2 == OP_IMUL_LL;
            numeric x1 = p#read(optc, i + 1)
            numeric y1 = p#read(optc, i + 2)
            if x1 < 0;
                return false
            break
            if x1 >= LOCAL_MAX;
                return false
            break
            if y1 < 0;
                return false
            break
            if y1 >= LOCAL_MAX;
                return false
            break
        elif op2 == OP_ISUB_LL;
            numeric x2 = p#read(optc, i + 1)
            numeric y2 = p#read(optc, i + 2)
            if x2 < 0;
                return false
            break
            if x2 >= LOCAL_MAX;
                return false
            break
            if y2 < 0;
                return false
            break
            if y2 >= LOCAL_MAX;
                return false
            break
        elif op2 == OP_INC_L;
            numeric x3 = p#read(optc, i + 1)
            if x3 < 0;
                return false
            break
            if x3 >= LOCAL_MAX;
                return false
            break
        elif op2 == OP_DEC_L;
            numeric x4 = p#read(optc, i + 1)
            if x4 < 0;
                return false
            break
            if x4 >= LOCAL_MAX;
                return false
            break
        elif op2 == OP_IADD_LN;
            numeric x5 = p#read(optc, i + 1)
            if x5 < 0;
                return false
            break
            if x5 >= LOCAL_MAX;
                return false
            break
        break
        i = i + w2 + 1
    break
    return true
break

fun dump_stack -> bool numeric r_sp, numeric r_tos, numeric r_has;
    numeric nshow = r_sp
    if r_has == 1;
        nshow = r_sp + 1
    break
    log "pila (sp=" + nshow + "):"
    if nshow == 0;
        log "  (vacia)"
    break
    numeric i = 0
    while i < r_sp;
        log "  [" + i + "] = " + p#read(stack, i)
        i = i + 1
    break
    if r_has == 1;
        log "  [" + r_sp + "] = " + r_tos
    break
    return true
break

fun has_label_in -> bool numeric from, numeric to;
    numeric k = 0
    while k < LAB_MAX;
        if p#read(labused, k) == 1;
            numeric a = p#read(labtab, k)
            if a > from;
                if a < to;
                    return true
                break
            break
        break
        k = k + 1
    break
    return false
break

fun peephole -> bool;
    numeric i = 0
    numeric ni = 0
    while i < code_len;
        p#write(remap, i, ni)
        numeric o0 = p#read(code, i)
        numeric fused = 0
        if i + 6 < code_len;
            numeric a = p#read(code, i + 1)
            if o0 == OP_LOAD;
                if p#read(code, i + 2) == OP_LOAD;
                    if p#read(code, i + 4) == OP_ADD;
                        if p#read(code, i + 5) == OP_STORE;
                            if p#read(code, i + 6) == a;
                                if has_label_in(i, i + 7) == false;
                                    p#write(optc, ni, OP_IADD_LL)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, p#read(code, i + 3))
                                    ni = ni + 3
                                    i = i + 7
                                    fused = 1
                                break
                            break
                        break
                    elif p#read(code, i + 4) == OP_MUL;
                        if p#read(code, i + 5) == OP_STORE;
                            if p#read(code, i + 6) == a;
                                if has_label_in(i, i + 7) == false;
                                    p#write(optc, ni, OP_IMUL_LL)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, p#read(code, i + 3))
                                    ni = ni + 3
                                    i = i + 7
                                    fused = 1
                                break
                            break
                        break
                    elif p#read(code, i + 4) == OP_SUB;
                        if p#read(code, i + 5) == OP_STORE;
                            if p#read(code, i + 6) == a;
                                if has_label_in(i, i + 7) == false;
                                    p#write(optc, ni, OP_ISUB_LL)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, p#read(code, i + 3))
                                    ni = ni + 3
                                    i = i + 7
                                    fused = 1
                                break
                            break
                        break
                    break
                elif p#read(code, i + 2) == OP_PUSH;
                    numeric nimm = p#read(code, i + 3)
                    if p#read(code, i + 4) == OP_ADD;
                        if p#read(code, i + 5) == OP_STORE;
                            if p#read(code, i + 6) == a;
                                if has_label_in(i, i + 7) == false;
                                    if nimm == 1;
                                        p#write(optc, ni, OP_INC_L)
                                        p#write(optc, ni + 1, a)
                                        ni = ni + 2
                                    else;
                                        p#write(optc, ni, OP_IADD_LN)
                                        p#write(optc, ni + 1, a)
                                        p#write(optc, ni + 2, nimm)
                                        ni = ni + 3
                                    break
                                    i = i + 7
                                    fused = 1
                                break
                            break
                        break
                    elif p#read(code, i + 4) == OP_SUB;
                        if p#read(code, i + 5) == OP_STORE;
                            if p#read(code, i + 6) == a;
                                if has_label_in(i, i + 7) == false;
                                    if nimm == 1;
                                        p#write(optc, ni, OP_DEC_L)
                                        p#write(optc, ni + 1, a)
                                        ni = ni + 2
                                    else;
                                        p#write(optc, ni, OP_SUB_LN)
                                        p#write(optc, ni + 1, a)
                                        p#write(optc, ni + 2, nimm)
                                        ni = ni + 3
                                    break
                                    i = i + 7
                                    fused = 1
                                break
                            break
                        break
                    elif p#read(code, i + 4) == OP_MUL;
                        if p#read(code, i + 5) == OP_STORE;
                            if p#read(code, i + 6) == a;
                                if has_label_in(i, i + 7) == false;
                                    p#write(optc, ni, OP_MUL_LN)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, nimm)
                                    ni = ni + 3
                                    i = i + 7
                                    fused = 1
                                break
                            break
                        break
                    elif i + 7 < code_len;
                        numeric cmpop = p#read(code, i + 4)
                        numeric jop = p#read(code, i + 5)
                        numeric tgt = p#read(code, i + 6)
                        if jop == OP_JNZ;
                            if has_label_in(i, i + 7) == false;
                                if cmpop == OP_LE;
                                    p#write(optc, ni, OP_JLE_LN)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, nimm)
                                    p#write(optc, ni + 3, tgt)
                                    ni = ni + 4
                                    i = i + 7
                                    fused = 1
                                elif cmpop == OP_LT;
                                    p#write(optc, ni, OP_JLT_LN)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, nimm)
                                    p#write(optc, ni + 3, tgt)
                                    ni = ni + 4
                                    i = i + 7
                                    fused = 1
                                elif cmpop == OP_GT;
                                    p#write(optc, ni, OP_JGT_LN)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, nimm)
                                    p#write(optc, ni + 3, tgt)
                                    ni = ni + 4
                                    i = i + 7
                                    fused = 1
                                elif cmpop == OP_GE;
                                    p#write(optc, ni, OP_JGE_LN)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, nimm)
                                    p#write(optc, ni + 3, tgt)
                                    ni = ni + 4
                                    i = i + 7
                                    fused = 1
                                break
                            break
                        elif jop == OP_JZ;
                            if has_label_in(i, i + 7) == false;
                                if cmpop == OP_GT;
                                    p#write(optc, ni, OP_JLE_LN)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, nimm)
                                    p#write(optc, ni + 3, tgt)
                                    ni = ni + 4
                                    i = i + 7
                                    fused = 1
                                elif cmpop == OP_LT;
                                    p#write(optc, ni, OP_JGE_LN)
                                    p#write(optc, ni + 1, a)
                                    p#write(optc, ni + 2, nimm)
                                    p#write(optc, ni + 3, tgt)
                                    ni = ni + 4
                                    i = i + 7
                                    fused = 1
                                break
                            break
                        break
                    break
                break
            break
        break
        if fused == 0;
            if i + 3 < code_len;
                if o0 == OP_LOAD;
                    if p#read(code, i + 2) == OP_JZ;
                        if has_label_in(i, i + 4) == false;
                            p#write(optc, ni, OP_JZ_L)
                            p#write(optc, ni + 1, p#read(code, i + 1))
                            p#write(optc, ni + 2, p#read(code, i + 3))
                            ni = ni + 3
                            i = i + 4
                            fused = 1
                        break
                    elif p#read(code, i + 2) == OP_JNZ;
                        if has_label_in(i, i + 4) == false;
                            p#write(optc, ni, OP_JNZ_L)
                            p#write(optc, ni + 1, p#read(code, i + 1))
                            p#write(optc, ni + 2, p#read(code, i + 3))
                            ni = ni + 3
                            i = i + 4
                            fused = 1
                        break
                    break
                break
            break
        break
        if fused == 0;
            p#write(optc, ni, o0)
            ni = ni + 1
            i = i + 1
            if needs_arg(o0);
                if i < code_len;
                    p#write(optc, ni, p#read(code, i))
                    p#write(remap, i, ni)
                    ni = ni + 1
                    i = i + 1
                break
            break
        break
    break
    numeric j = 0
    while j < ni;
        numeric op = p#read(optc, j)
        if op == OP_JMP;
            p#write(optc, j + 1, p#read(remap, p#read(optc, j + 1)))
            j = j + 2
        elif op == OP_JZ;
            p#write(optc, j + 1, p#read(remap, p#read(optc, j + 1)))
            j = j + 2
        elif op == OP_JNZ;
            p#write(optc, j + 1, p#read(remap, p#read(optc, j + 1)))
            j = j + 2
        elif op == OP_CALL;
            p#write(optc, j + 1, p#read(remap, p#read(optc, j + 1)))
            j = j + 2
        elif op == OP_JLE_LN;
            p#write(optc, j + 3, p#read(remap, p#read(optc, j + 3)))
            j = j + 4
        elif op == OP_JGT_LN;
            p#write(optc, j + 3, p#read(remap, p#read(optc, j + 3)))
            j = j + 4
        elif op == OP_JLT_LN;
            p#write(optc, j + 3, p#read(remap, p#read(optc, j + 3)))
            j = j + 4
        elif op == OP_JGE_LN;
            p#write(optc, j + 3, p#read(remap, p#read(optc, j + 3)))
            j = j + 4
        elif op == OP_JZ_L;
            p#write(optc, j + 2, p#read(remap, p#read(optc, j + 2)))
            j = j + 3
        elif op == OP_JNZ_L;
            p#write(optc, j + 2, p#read(remap, p#read(optc, j + 2)))
            j = j + 3
        elif op == OP_PUSH;
            j = j + 2
        elif op == OP_LOAD;
            j = j + 2
        elif op == OP_STORE;
            j = j + 2
        elif op == OP_ARG;
            j = j + 2
        elif op == OP_PUSHS;
            j = j + 2
        elif op == OP_INPUT;
            j = j + 2
        elif op == OP_INPUTN;
            j = j + 2
        elif op == OP_IADD_LL;
            j = j + 3
        elif op == OP_IMUL_LL;
            j = j + 3
        elif op == OP_ISUB_LL;
            j = j + 3
        elif op == OP_INC_L;
            j = j + 2
        elif op == OP_DEC_L;
            j = j + 2
        elif op == OP_IADD_LN;
            j = j + 3
        else;
            j = j + 1
        break
    break
    opt_len = ni
    xc = []
    numeric ci = 0
    while ci < ni;
        xc.append(p#read(optc, ci))
        ci = ci + 1
    break
    return true
break

fun remap_clear -> bool;
    numeric z = 0
    while z < CODE_MAX;
        p#write(remap, z, 0)
        z = z + 1
    break
    return true
break

fun opt_finish -> bool numeric ni;
    numeric j = 0
    while j < ni;
        numeric op = p#read(code, j)
        if op == OP_JMP;
            numeric t = p#read(code, j + 1)
            if t >= 0;
                if t < CODE_MAX;
                    p#write(code, j + 1, p#read(remap, t))
                break
            break
            j = j + 2
        elif op == OP_JZ;
            numeric t2 = p#read(code, j + 1)
            if t2 >= 0;
                if t2 < CODE_MAX;
                    p#write(code, j + 1, p#read(remap, t2))
                break
            break
            j = j + 2
        elif op == OP_JNZ;
            numeric t3 = p#read(code, j + 1)
            if t3 >= 0;
                if t3 < CODE_MAX;
                    p#write(code, j + 1, p#read(remap, t3))
                break
            break
            j = j + 2
        elif op == OP_CALL;
            numeric t4 = p#read(code, j + 1)
            if t4 >= 0;
                if t4 < CODE_MAX;
                    p#write(code, j + 1, p#read(remap, t4))
                break
            break
            j = j + 2
        elif op == OP_JLE_LN;
            numeric t5 = p#read(code, j + 3)
            if t5 >= 0;
                if t5 < CODE_MAX;
                    p#write(code, j + 3, p#read(remap, t5))
                break
            break
            j = j + 4
        elif op == OP_JGT_LN;
            numeric t6 = p#read(code, j + 3)
            if t6 >= 0;
                if t6 < CODE_MAX;
                    p#write(code, j + 3, p#read(remap, t6))
                break
            break
            j = j + 4
        elif op == OP_JLT_LN;
            numeric t7 = p#read(code, j + 3)
            if t7 >= 0;
                if t7 < CODE_MAX;
                    p#write(code, j + 3, p#read(remap, t7))
                break
            break
            j = j + 4
        elif op == OP_JGE_LN;
            numeric t8 = p#read(code, j + 3)
            if t8 >= 0;
                if t8 < CODE_MAX;
                    p#write(code, j + 3, p#read(remap, t8))
                break
            break
            j = j + 4
        elif op == OP_JZ_L;
            numeric t9 = p#read(code, j + 2)
            if t9 >= 0;
                if t9 < CODE_MAX;
                    p#write(code, j + 2, p#read(remap, t9))
                break
            break
            j = j + 3
        elif op == OP_JNZ_L;
            numeric t10 = p#read(code, j + 2)
            if t10 >= 0;
                if t10 < CODE_MAX;
                    p#write(code, j + 2, p#read(remap, t10))
                break
            break
            j = j + 3
        else;
            numeric w = opcode_width(op)
            if w < 0;
                w = 0
            break
            j = j + w + 1
        break
    break
    opt_len = ni
    numeric i = 0
    while i < ni;
        p#write(optc, i, p#read(code, i))
        i = i + 1
    break
    xc = []
    i = 0
    while i < ni;
        xc.append(p#read(optc, i))
        i = i + 1
    break
    return true
break

fun opt_emit_op -> numeric numeric ni, numeric op;
    p#write(code, ni, op)
    return ni + 1
break

fun opt_emit_op1 -> numeric numeric ni, numeric op, numeric a;
    p#write(code, ni, op)
    p#write(code, ni + 1, a)
    return ni + 2
break

fun opt_emit_op2 -> numeric numeric ni, numeric op, numeric a, numeric b;
    p#write(code, ni, op)
    p#write(code, ni + 1, a)
    p#write(code, ni + 2, b)
    return ni + 3
break

fun opt_copy_instr -> numeric numeric ni, numeric i;
    numeric op = p#read(optc, i)
    numeric w = opcode_width(op)
    if w < 0;
        w = 0
    break
    p#write(code, ni, op)
    numeric k = 1
    while k <= w;
        p#write(code, ni + k, p#read(optc, i + k))
        k = k + 1
    break
    return ni + w + 1
break

fun opt_mark_range -> bool numeric from, numeric to, numeric ni;
    numeric k = from
    while k < to;
        p#write(remap, k, ni)
        k = k + 1
    break
    return true
break

fun const_fold -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_PUSH;
            if i + 4 < opt_len;
                if p#read(optc, i + 2) == OP_PUSH;
                    numeric a = p#read(optc, i + 1)
                    numeric b = p#read(optc, i + 3)
                    numeric op3 = p#read(optc, i + 4)
                    numeric ok = 0
                    numeric r = 0
                    if op3 == OP_ADD;
                        r = a + b
                        ok = 1
                    elif op3 == OP_SUB;
                        r = a - b
                        ok = 1
                    elif op3 == OP_MUL;
                        r = a * b
                        ok = 1
                    elif op3 == OP_AND;
                        r = a & b
                        ok = 1
                    elif op3 == OP_OR;
                        r = a | b
                        ok = 1
                    elif op3 == OP_XOR;
                        r = a ^ b
                        ok = 1
                    elif op3 == OP_EQ;
                        if a == b;
                            r = 1
                        break
                        ok = 1
                    elif op3 == OP_NE;
                        if a != b;
                            r = 1
                        break
                        ok = 1
                    elif op3 == OP_LT;
                        if a < b;
                            r = 1
                        break
                        ok = 1
                    elif op3 == OP_GT;
                        if a > b;
                            r = 1
                        break
                        ok = 1
                    elif op3 == OP_LE;
                        if a < b;
                            r = 1
                        elif a == b;
                            r = 1
                        break
                        ok = 1
                    elif op3 == OP_GE;
                        if a > b;
                            r = 1
                        elif a == b;
                            r = 1
                        break
                        ok = 1
                    elif op3 == OP_DIV;
                        if b != 0;
                            r = a / b
                            ok = 1
                        break
                    elif op3 == OP_MOD;
                        if b != 0;
                            r = a % b
                            ok = 1
                        break
                    elif op3 == OP_SHL;
                        r = a << b
                        ok = 1
                    elif op3 == OP_SHR;
                        r = a >> b
                        ok = 1
                    break
                    if ok == 1;
                        opt_mark_range(i, i + 5, ni)
                        ni = opt_emit_op1(ni, OP_PUSH, r)
                        i = i + 5
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                break
            break
            if fused == 0;
                if i + 2 < opt_len;
                    numeric op2 = p#read(optc, i + 2)
                    numeric v = p#read(optc, i + 1)
                    if op2 == OP_NEG;
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op1(ni, OP_PUSH, 0 - v)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_NOT;
                        numeric nv = 0
                        if v == 0;
                            nv = 1
                        break
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op1(ni, OP_PUSH, nv)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun algebraic -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_PUSH;
            numeric v = p#read(optc, i + 1)
            if i + 2 < opt_len;
                numeric op2 = p#read(optc, i + 2)
                if v == 0;
                    if op2 == OP_ADD;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_OR;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_XOR;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_SUB;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                elif v == 1;
                    if op2 == OP_MUL;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_AND;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                break
            break
            if fused == 0;
                if i + 3 < opt_len;
                    if p#read(optc, i + 2) == OP_JZ;
                        if v == 0;
                            opt_mark_range(i, i + 4, ni)
                            ni = opt_emit_op1(ni, OP_JMP, p#read(optc, i + 3))
                            i = i + 4
                            fused = 1
                            opt_removed = opt_removed + 1
                        else;
                            opt_mark_range(i, i + 4, ni)
                            i = i + 4
                            fused = 1
                            opt_removed = opt_removed + 1
                        break
                    elif p#read(optc, i + 2) == OP_JNZ;
                        if v == 0;
                            opt_mark_range(i, i + 4, ni)
                            i = i + 4
                            fused = 1
                            opt_removed = opt_removed + 1
                        else;
                            opt_mark_range(i, i + 4, ni)
                            ni = opt_emit_op1(ni, OP_JMP, p#read(optc, i + 3))
                            i = i + 4
                            fused = 1
                            opt_removed = opt_removed + 1
                        break
                    break
                break
            break
        elif op == OP_IADD_LN;
            if i + 2 < opt_len;
                if p#read(optc, i + 2) == 0;
                    opt_mark_range(i, i + 3, ni)
                    i = i + 3
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        elif op == OP_NEG;
            if i + 1 < opt_len;
                if p#read(optc, i + 1) == OP_NEG;
                    opt_mark_range(i, i + 2, ni)
                    i = i + 2
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        elif op == OP_NOT;
            if i + 1 < opt_len;
                if p#read(optc, i + 1) == OP_NOT;
                    opt_mark_range(i, i + 2, ni)
                    i = i + 2
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun peephole_extra -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_CALL;
            if i + 2 < opt_len;
                if p#read(optc, i + 2) == OP_RET;
                    opt_mark_range(i, i + 3, ni)
                    ni = opt_emit_op1(ni, OP_JMP, p#read(optc, i + 1))
                    i = i + 3
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        elif op == OP_PUSH;
            if i + 2 < opt_len;
                if p#read(optc, i + 1) == 0;
                    if p#read(optc, i + 2) == OP_EQ;
                        if is_jump_target(i) == false;
                            if is_jump_target(i + 2) == false;
                                opt_mark_range(i, i + 3, ni)
                                ni = opt_emit_op(ni, OP_NOT)
                                i = i + 3
                                fused = 1
                                opt_removed = opt_removed + 1
                            break
                        break
                    elif p#read(optc, i + 2) == OP_POP;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                elif p#read(optc, i + 2) == OP_POP;
                    opt_mark_range(i, i + 3, ni)
                    i = i + 3
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        elif op == OP_DUP;
            if i + 1 < opt_len;
                if p#read(optc, i + 1) == OP_POP;
                    opt_mark_range(i, i + 2, ni)
                    i = i + 2
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        elif op == OP_LOAD;
            if i + 3 < opt_len;
                numeric slot = p#read(optc, i + 1)
                if p#read(optc, i + 2) == OP_STORE;
                    if p#read(optc, i + 3) == slot;
                        opt_mark_range(i, i + 4, ni)
                        i = i + 4
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                break
            break
        elif op == OP_JMP;
            if i + 1 < opt_len;
                numeric t = p#read(optc, i + 1)
                if t == i + 2;
                    opt_mark_range(i, i + 2, ni)
                    i = i + 2
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun jump_thread -> bool;
    numeric j = 0
    numeric op = 0
    numeric jdst = 0
    numeric hops = 0
    numeric nt = 0
    numeric w = 0
    numeric i = 0
    numeric done = 0
    while j < opt_len;
        op = p#read(optc, j)
        if op == OP_JMP;
            jdst = p#read(optc, j + 1)
            hops = 0
            done = 0
            while done == 0;
                if hops >= 16;
                    done = 1
                elif jdst < 0;
                    done = 1
                elif jdst >= opt_len;
                    done = 1
                elif p#read(optc, jdst) != OP_JMP;
                    done = 1
                else;
                    nt = p#read(optc, jdst + 1)
                    if nt == jdst;
                        done = 1
                    else;
                        jdst = nt
                        hops = hops + 1
                    break
                break
            break
            if hops > 0;
                p#write(optc, j + 1, jdst)
                opt_removed = opt_removed + hops
            break
            if jdst >= 0;
                if jdst < opt_len;
                    if p#read(optc, jdst) == OP_HALT;
                        p#write(optc, j, OP_HALT)
                    break
                break
            break
            j = j + 2
        else;
            w = opcode_width(op)
            if w < 0;
                w = 0
            break
            j = j + w + 1
        break
    break
    xc = []
    i = 0
    while i < opt_len;
        xc.append(p#read(optc, i))
        i = i + 1
    break
    return true
break


fun branch_simplify -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_JMP;
            numeric t0 = p#read(optc, i + 1)
            if t0 == i + 2;
                opt_mark_range(i, i + 2, ni)
                i = i + 2
                fused = 1
                opt_removed = opt_removed + 1
            break
        elif op == OP_JZ;
            numeric t = p#read(optc, i + 1)
            if t == i + 2;
                opt_mark_range(i, i + 2, ni)
                ni = opt_emit_op(ni, OP_POP)
                i = i + 2
                fused = 1
                opt_removed = opt_removed + 1
            break
        elif op == OP_JNZ;
            numeric t2 = p#read(optc, i + 1)
            if t2 == i + 2;
                opt_mark_range(i, i + 2, ni)
                ni = opt_emit_op(ni, OP_POP)
                i = i + 2
                fused = 1
                opt_removed = opt_removed + 1
            break
        elif op == OP_HALT;
            if i + 1 < opt_len;
                if p#read(optc, i + 1) == OP_HALT;
                    opt_mark_range(i, i + 2, ni)
                    ni = opt_emit_op(ni, OP_HALT)
                    i = i + 2
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun local_used_before_store -> bool numeric from, numeric slot;
    numeric j = from
    while j < opt_len;
        numeric op = p#read(optc, j)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_LOAD;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_IADD_LL;
            if p#read(optc, j + 1) == slot;
                return true
            break
            if p#read(optc, j + 2) == slot;
                return true
            break
        elif op == OP_IMUL_LL;
            if p#read(optc, j + 1) == slot;
                return true
            break
            if p#read(optc, j + 2) == slot;
                return true
            break
        elif op == OP_ISUB_LL;
            if p#read(optc, j + 1) == slot;
                return true
            break
            if p#read(optc, j + 2) == slot;
                return true
            break
        elif op == OP_INC_L;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_DEC_L;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_IADD_LN;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_SUB_LN;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_MUL_LN;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_JLE_LN;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_JGT_LN;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_JLT_LN;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_JGE_LN;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_JZ_L;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_JNZ_L;
            if p#read(optc, j + 1) == slot;
                return true
            break
        elif op == OP_STORE;
            if p#read(optc, j + 1) == slot;
                return false
            break
        elif op == OP_JMP;
            return true
        elif op == OP_JZ;
            return true
        elif op == OP_JNZ;
            return true
        elif op == OP_CALL;
            return true
        elif op == OP_HALT;
            return false
        elif op == OP_RET;
            return false
        elif op == OP_DIV_LN;
            if p#read(optc, j + 1) == slot;
                return true
            break
        break
        j = j + w + 1
    break
    return false
break

fun dead_store -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_STORE;
            numeric s1 = p#read(optc, i + 1)
            if i + 3 < opt_len;
                if p#read(optc, i + 2) == OP_STORE;
                    if p#read(optc, i + 3) == s1;
                        opt_mark_range(i, i + 4, ni)
                        ni = opt_emit_op(ni, OP_POP)
                        ni = opt_emit_op1(ni, OP_STORE, s1)
                        i = i + 4
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                break
            break
            if fused == 0;
                if is_jump_target(i) == false;
                    if local_used_before_store(i + 2, s1) == false;
                        opt_mark_range(i, i + 2, ni)
                        ni = opt_emit_op(ni, OP_POP)
                        i = i + 2
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break


fun is_jump_target -> bool numeric addr;
    numeric j = 0
    while j < opt_len;
        numeric op = p#read(optc, j)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_JMP;
            if p#read(optc, j + 1) == addr;
                return true
            break
        elif op == OP_JZ;
            if p#read(optc, j + 1) == addr;
                return true
            break
        elif op == OP_JNZ;
            if p#read(optc, j + 1) == addr;
                return true
            break
        elif op == OP_CALL;
            if p#read(optc, j + 1) == addr;
                return true
            break
        elif op == OP_JLE_LN;
            if p#read(optc, j + 3) == addr;
                return true
            break
        elif op == OP_JGT_LN;
            if p#read(optc, j + 3) == addr;
                return true
            break
        elif op == OP_JLT_LN;
            if p#read(optc, j + 3) == addr;
                return true
            break
        elif op == OP_JGE_LN;
            if p#read(optc, j + 3) == addr;
                return true
            break
        elif op == OP_JZ_L;
            if p#read(optc, j + 2) == addr;
                return true
            break
        elif op == OP_JNZ_L;
            if p#read(optc, j + 2) == addr;
                return true
            break
        break
        j = j + w + 1
    break
    return false
break

fun load_fwd -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_PUSH;
            if i + 5 < opt_len;
                if p#read(optc, i + 2) == OP_STORE;
                    numeric s0 = p#read(optc, i + 3)
                    if p#read(optc, i + 4) == OP_LOAD;
                        if p#read(optc, i + 5) == s0;
                            if is_jump_target(i + 4) == false;
                                numeric pv = p#read(optc, i + 1)
                                opt_mark_range(i, i + 6, ni)
                                ni = opt_emit_op1(ni, OP_PUSH, pv)
                                ni = opt_emit_op(ni, OP_DUP)
                                ni = opt_emit_op1(ni, OP_STORE, s0)
                                i = i + 6
                                fused = 1
                                opt_removed = opt_removed + 1
                            break
                        break
                    break
                break
            break
        elif op == OP_LOAD;
            if i + 3 < opt_len;
                numeric s = p#read(optc, i + 1)
                if p#read(optc, i + 2) == OP_LOAD;
                    if p#read(optc, i + 3) == s;
                        if is_jump_target(i + 2) == false;
                            if is_jump_target(i) == false;
                                opt_mark_range(i, i + 4, ni)
                                ni = opt_emit_op1(ni, OP_LOAD, s)
                                ni = opt_emit_op(ni, OP_DUP)
                                i = i + 4
                                fused = 1
                                opt_removed = opt_removed + 1
                            break
                        break
                    break
                break
            break
            if i + 5 < opt_len;
                numeric s2 = p#read(optc, i + 1)
                if p#read(optc, i + 2) == OP_LOAD;
                    if p#read(optc, i + 3) == s2;
                        if is_jump_target(i) == false;
                            if is_jump_target(i + 2) == false;
                                numeric cop = p#read(optc, i + 4)
                                if cop == OP_EQ;
                                    opt_mark_range(i, i + 5, ni)
                                    ni = opt_emit_op1(ni, OP_PUSH, 1)
                                    i = i + 5
                                    fused = 1
                                    opt_removed = opt_removed + 1
                                elif cop == OP_NE;
                                    opt_mark_range(i, i + 5, ni)
                                    ni = opt_emit_op1(ni, OP_PUSH, 0)
                                    i = i + 5
                                    fused = 1
                                    opt_removed = opt_removed + 1
                                elif cop == OP_LT;
                                    opt_mark_range(i, i + 5, ni)
                                    ni = opt_emit_op1(ni, OP_PUSH, 0)
                                    i = i + 5
                                    fused = 1
                                    opt_removed = opt_removed + 1
                                elif cop == OP_GT;
                                    opt_mark_range(i, i + 5, ni)
                                    ni = opt_emit_op1(ni, OP_PUSH, 0)
                                    i = i + 5
                                    fused = 1
                                    opt_removed = opt_removed + 1
                                elif cop == OP_LE;
                                    opt_mark_range(i, i + 5, ni)
                                    ni = opt_emit_op1(ni, OP_PUSH, 1)
                                    i = i + 5
                                    fused = 1
                                    opt_removed = opt_removed + 1
                                elif cop == OP_GE;
                                    opt_mark_range(i, i + 5, ni)
                                    ni = opt_emit_op1(ni, OP_PUSH, 1)
                                    i = i + 5
                                    fused = 1
                                    opt_removed = opt_removed + 1
                                break
                            break
                        break
                    break
                break
            break
        elif op == OP_STORE;
            if i + 3 < opt_len;
                numeric s2 = p#read(optc, i + 1)
                if p#read(optc, i + 2) == OP_LOAD;
                    if p#read(optc, i + 3) == s2;
                        if is_jump_target(i + 2) == false;
                            opt_mark_range(i, i + 4, ni)
                            ni = opt_emit_op(ni, OP_DUP)
                            ni = opt_emit_op1(ni, OP_STORE, s2)
                            i = i + 4
                            fused = 1
                            opt_removed = opt_removed + 1
                        break
                    break
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun strength -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_PUSH;
            if i + 2 < opt_len;
                numeric v = p#read(optc, i + 1)
                numeric op2 = p#read(optc, i + 2)
                if v == 2;
                    if op2 == OP_MUL;
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op(ni, OP_DUP)
                        ni = opt_emit_op(ni, OP_ADD)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_SHL;
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op(ni, OP_DUP)
                        ni = opt_emit_op(ni, OP_ADD)
                        ni = opt_emit_op(ni, OP_DUP)
                        ni = opt_emit_op(ni, OP_ADD)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                elif v == 1;
                    if op2 == OP_MUL;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_DIV;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_SHL;
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op(ni, OP_DUP)
                        ni = opt_emit_op(ni, OP_ADD)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                elif v == 0;
                    if op2 == OP_SHL;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_SHR;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_MUL;
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op(ni, OP_POP)
                        ni = opt_emit_op1(ni, OP_PUSH, 0)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_AND;
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op(ni, OP_POP)
                        ni = opt_emit_op1(ni, OP_PUSH, 0)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_ADD;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_OR;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    elif op2 == OP_SUB;
                        opt_mark_range(i, i + 3, ni)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                elif v == 0 - 1;
                    if op2 == OP_MUL;
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op(ni, OP_NEG)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun mark_reachable -> bool;
    numeric i = 0
    while i < opt_len;
        p#write(boundary, i, 0)
        i = i + 1
    break
    if opt_len < 1;
        return true
    break
    list work = []
    work.append(0)
    p#write(boundary, 0, 1)
    numeric wi = 0
    while wi < length(work);
        numeric at = work[wi]
        wi = wi + 1
        if at < 0;
        elif at >= opt_len;
        else;
            numeric op = p#read(optc, at)
            numeric w = opcode_width(op)
            if w < 0;
                w = 0
            break
            numeric fall = at + w + 1
            if op == OP_HALT;
            elif op == OP_HALTC;
            elif op == OP_JMP;
                numeric t = p#read(optc, at + 1)
                if t >= 0;
                    if t < opt_len;
                        if p#read(boundary, t) == 0;
                            p#write(boundary, t, 1)
                            work.append(t)
                        break
                    break
                break
            else;
                if op == OP_JZ;
                    numeric t2 = p#read(optc, at + 1)
                    if t2 >= 0;
                        if t2 < opt_len;
                            if p#read(boundary, t2) == 0;
                                p#write(boundary, t2, 1)
                                work.append(t2)
                            break
                        break
                    break
                elif op == OP_JNZ;
                    numeric t3 = p#read(optc, at + 1)
                    if t3 >= 0;
                        if t3 < opt_len;
                            if p#read(boundary, t3) == 0;
                                p#write(boundary, t3, 1)
                                work.append(t3)
                            break
                        break
                    break
                elif op == OP_CALL;
                    numeric t4 = p#read(optc, at + 1)
                    if t4 >= 0;
                        if t4 < opt_len;
                            if p#read(boundary, t4) == 0;
                                p#write(boundary, t4, 1)
                                work.append(t4)
                            break
                        break
                    break
                elif op == OP_JLE_LN;
                    numeric t5 = p#read(optc, at + 3)
                    if t5 >= 0;
                        if t5 < opt_len;
                            if p#read(boundary, t5) == 0;
                                p#write(boundary, t5, 1)
                                work.append(t5)
                            break
                        break
                    break
                elif op == OP_JGT_LN;
                    numeric t6 = p#read(optc, at + 3)
                    if t6 >= 0;
                        if t6 < opt_len;
                            if p#read(boundary, t6) == 0;
                                p#write(boundary, t6, 1)
                                work.append(t6)
                            break
                        break
                    break
                elif op == OP_JLT_LN;
                    numeric t7 = p#read(optc, at + 3)
                    if t7 >= 0;
                        if t7 < opt_len;
                            if p#read(boundary, t7) == 0;
                                p#write(boundary, t7, 1)
                                work.append(t7)
                            break
                        break
                    break
                elif op == OP_JGE_LN;
                    numeric t8 = p#read(optc, at + 3)
                    if t8 >= 0;
                        if t8 < opt_len;
                            if p#read(boundary, t8) == 0;
                                p#write(boundary, t8, 1)
                                work.append(t8)
                            break
                        break
                    break
                elif op == OP_JZ_L;
                    numeric t9 = p#read(optc, at + 2)
                    if t9 >= 0;
                        if t9 < opt_len;
                            if p#read(boundary, t9) == 0;
                                p#write(boundary, t9, 1)
                                work.append(t9)
                            break
                        break
                    break
                elif op == OP_JNZ_L;
                    numeric t10 = p#read(optc, at + 2)
                    if t10 >= 0;
                        if t10 < opt_len;
                            if p#read(boundary, t10) == 0;
                                p#write(boundary, t10, 1)
                                work.append(t10)
                            break
                        break
                    break
                break
                if fall < opt_len;
                    if p#read(boundary, fall) == 0;
                        p#write(boundary, fall, 1)
                        work.append(fall)
                    break
                break
            break
        break
    break
    return true
break

fun dce -> bool;
    if opt_len < 1;
        return true
    break
    mark_reachable()
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if p#read(boundary, i) == 1;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        else;
            opt_mark_range(i, i + w + 1, ni)
            opt_removed = opt_removed + 1
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun lower_raw -> bool;
    opt_len = code_len
    numeric i = 0
    while i < code_len;
        p#write(optc, i, p#read(code, i))
        i = i + 1
    break
    xc = []
    i = 0
    while i < opt_len;
        xc.append(p#read(optc, i))
        i = i + 1
    break
    return true
break

fun sync_optc_to_code -> bool;
    code_len = opt_len
    numeric i = 0
    while i < opt_len;
        p#write(code, i, p#read(optc, i))
        i = i + 1
    break
    return true
break

fun is_pure_binop -> bool numeric op;
    if op == OP_ADD;
        return true
    elif op == OP_SUB;
        return true
    elif op == OP_MUL;
        return true
    elif op == OP_DIV;
        return true
    elif op == OP_MOD;
        return true
    elif op == OP_AND;
        return true
    elif op == OP_OR;
        return true
    elif op == OP_XOR;
        return true
    elif op == OP_SHL;
        return true
    elif op == OP_SHR;
        return true
    elif op == OP_EQ;
        return true
    elif op == OP_NE;
        return true
    elif op == OP_LT;
        return true
    elif op == OP_LE;
        return true
    elif op == OP_GT;
        return true
    elif op == OP_GE;
        return true
    break
    return false
break

fun dead_pure -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_PUSH;
            if i + 2 < opt_len;
                if p#read(optc, i + 2) == OP_POP;
                    opt_mark_range(i, i + 3, ni)
                    i = i + 3
                    fused = 1
                    opt_removed = opt_removed + 1
                elif p#read(optc, i + 2) == OP_NEG;
                    if i + 3 < opt_len;
                        if p#read(optc, i + 3) == OP_POP;
                            opt_mark_range(i, i + 4, ni)
                            i = i + 4
                            fused = 1
                            opt_removed = opt_removed + 1
                        break
                    break
                elif p#read(optc, i + 2) == OP_NOT;
                    if i + 3 < opt_len;
                        if p#read(optc, i + 3) == OP_POP;
                            opt_mark_range(i, i + 4, ni)
                            i = i + 4
                            fused = 1
                            opt_removed = opt_removed + 1
                        break
                    break
                elif p#read(optc, i + 2) == OP_DUP;
                    if i + 4 < opt_len;
                        if p#read(optc, i + 3) == OP_ADD;
                            if p#read(optc, i + 4) == OP_POP;
                                opt_mark_range(i, i + 5, ni)
                                i = i + 5
                                fused = 1
                                opt_removed = opt_removed + 1
                            break
                        break
                    break
                elif p#read(optc, i + 2) == OP_PUSH;
                    if i + 5 < opt_len;
                        numeric opb = p#read(optc, i + 4)
                        if is_pure_binop(opb);
                            if p#read(optc, i + 5) == OP_POP;
                                opt_mark_range(i, i + 6, ni)
                                i = i + 6
                                fused = 1
                                opt_removed = opt_removed + 1
                            break
                        break
                    break
                break
            break
        elif op == OP_DUP;
            if i + 1 < opt_len;
                if p#read(optc, i + 1) == OP_POP;
                    opt_mark_range(i, i + 2, ni)
                    i = i + 2
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        elif op == OP_LOAD;
            if i + 2 < opt_len;
                if p#read(optc, i + 2) == OP_POP;
                    opt_mark_range(i, i + 3, ni)
                    i = i + 3
                    fused = 1
                    opt_removed = opt_removed + 1
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun fuse_inc_jle -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_LOAD;
            if i + 12 < opt_len;
                numeric slot = p#read(optc, i + 1)
                if p#read(optc, i + 2) == OP_PUSH;
                    if p#read(optc, i + 3) == 1;
                        if p#read(optc, i + 4) == OP_ADD;
                            if p#read(optc, i + 5) == OP_DUP;
                                if p#read(optc, i + 6) == OP_STORE;
                                    if p#read(optc, i + 7) == slot;
                                        if p#read(optc, i + 8) == OP_PUSH;
                                            numeric lim = p#read(optc, i + 9)
                                            if p#read(optc, i + 10) == OP_LE;
                                                if p#read(optc, i + 11) == OP_JNZ;
                                                    numeric tgt = p#read(optc, i + 12)
                                                    if is_jump_target(i) == false;
                                                        if is_jump_target(i + 2) == false;
                                                            if is_jump_target(i + 4) == false;
                                                                if is_jump_target(i + 5) == false;
                                                                    if is_jump_target(i + 6) == false;
                                                                        if is_jump_target(i + 8) == false;
                                                                            if is_jump_target(i + 10) == false;
                                                                                if is_jump_target(i + 11) == false;
                                                                                    opt_mark_range(i, i + 13, ni)
                                                                                    ni = opt_emit_op1(ni, OP_INC_L, slot)
                                                                                    p#write(code, ni, OP_JLE_LN)
                                                                                    p#write(code, ni + 1, slot)
                                                                                    p#write(code, ni + 2, lim)
                                                                                    p#write(code, ni + 3, tgt)
                                                                                    p#write(remap, i + 11, ni)
                                                                                    p#write(remap, i + 12, ni)
                                                                                    ni = ni + 4
                                                                                    i = i + 13
                                                                                    fused = 1
                                                                                    opt_removed = opt_removed + 1
                                                                                break
                                                                            break
                                                                        break
                                                                    break
                                                                break
                                                            break
                                                        break
                                                    break
                                                break
                                            break
                                        break
                                    break
                                break
                            break
                        break
                    break
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break


fun opt_backup -> bool;
    optbak_len = opt_len
    numeric i = 0
    while i < opt_len;
        p#write(optbak, i, p#read(optc, i))
        i = i + 1
    break
    return true
break

fun opt_restore -> bool;
    opt_len = optbak_len
    numeric i = 0
    while i < opt_len;
        p#write(optc, i, p#read(optbak, i))
        i = i + 1
    break
    xc = []
    i = 0
    while i < opt_len;
        xc.append(p#read(optc, i))
        i = i + 1
    break
    return true
break

fun stack_delta -> numeric numeric op;
    if op == OP_PUSH;
        return 1
    elif op == OP_PUSHS;
        return 1
    elif op == OP_POP;
        return 0 - 1
    elif op == OP_DUP;
        return 1
    elif op == OP_SWAP;
        return 0
    elif op == OP_OVER;
        return 1
    elif op == OP_ROT;
        return 0
    elif op == OP_ADD;
        return 0 - 1
    elif op == OP_SUB;
        return 0 - 1
    elif op == OP_MUL;
        return 0 - 1
    elif op == OP_DIV;
        return 0 - 1
    elif op == OP_MOD;
        return 0 - 1
    elif op == OP_NEG;
        return 0
    elif op == OP_NOT;
        return 0
    elif op == OP_AND;
        return 0 - 1
    elif op == OP_OR;
        return 0 - 1
    elif op == OP_XOR;
        return 0 - 1
    elif op == OP_SHL;
        return 0 - 1
    elif op == OP_SHR;
        return 0 - 1
    elif op == OP_EQ;
        return 0 - 1
    elif op == OP_NE;
        return 0 - 1
    elif op == OP_LT;
        return 0 - 1
    elif op == OP_LE;
        return 0 - 1
    elif op == OP_GT;
        return 0 - 1
    elif op == OP_GE;
        return 0 - 1
    elif op == OP_LOAD;
        return 1
    elif op == OP_STORE;
        return 0 - 1
    elif op == OP_JMP;
        return 0
    elif op == OP_JZ;
        return 0 - 1
    elif op == OP_JNZ;
        return 0 - 1
    elif op == OP_CALL;
        return 0
    elif op == OP_RET;
        return 0
    elif op == OP_PRINT;
        return 0 - 1
    elif op == OP_PRINTS;
        return 0 - 1
    elif op == OP_HALT;
        return 0
    elif op == OP_HALTC;
        return 0
    elif op == OP_IADD_LL;
        return 0
    elif op == OP_IMUL_LL;
        return 0
    elif op == OP_ISUB_LL;
        return 0
    elif op == OP_INC_L;
        return 0
    elif op == OP_DEC_L;
        return 0
    elif op == OP_IADD_LN;
        return 0
    elif op == OP_SUB_LN;
        return 0
    elif op == OP_MUL_LN;
        return 0
    elif op == OP_DIV_LN;
        return 0
    elif op == OP_JLE_LN;
        return 0
    elif op == OP_JGT_LN;
        return 0
    elif op == OP_JLT_LN;
        return 0
    elif op == OP_JGE_LN;
        return 0
    elif op == OP_JZ_L;
        return 0
    elif op == OP_JNZ_L;
        return 0
    elif op == OP_STRLEN;
        return 0
    elif op == OP_STRCAT;
        return 0 - 1
    elif op == OP_STRCMP;
        return 0 - 1
    elif op == OP_ASSERT;
        return 0 - 1
    elif op == OP_EXEC;
        return 0
    elif op == OP_ITOA;
        return 0
    elif op == OP_ATOI;
        return 0
    break
    return 0
break

fun check_stack_heights -> bool;
    numeric depth = 0
    numeric i = 0
    while i < opt_len;
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            return false
        break
        numeric need = stack_need(op)
        if depth < need;
            return false
        break
        depth = depth + stack_delta(op)
        if depth < 0;
            return false
        break
        if depth > STACK_MAX;
            return false
        break
        i = i + w + 1
    break
    return true
break

fun safe_opt_pass -> bool text pname;
    last_opt_pass = pname
    opt_backup()
    return true
break

fun safe_opt_commit -> bool text pname;
    if verify_bytecode() == false;
        log "opt: pasada '" + pname + "' rechazada: bytecode invalido (revertida)"
        opt_restore()
        return false
    break
    return true
break


fun tail_call -> bool;
    remap_clear()
    numeric i = 0
    numeric ni = 0
    while i < opt_len;
        numeric fused = 0
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_CALL;
            if i + 2 < opt_len;
                if p#read(optc, i + 2) == OP_RET;
                    if is_jump_target(i + 2) == false;
                        numeric tgt = p#read(optc, i + 1)
                        opt_mark_range(i, i + 3, ni)
                        ni = opt_emit_op1(ni, OP_JMP, tgt)
                        i = i + 3
                        fused = 1
                        opt_removed = opt_removed + 1
                    break
                break
            break
        break
        if fused == 0;
            p#write(remap, i, ni)
            ni = opt_copy_instr(ni, i)
            i = i + w + 1
        break
    break
    opt_finish(ni)
    return true
break

fun optimize_round -> bool;
    safe_opt_pass("const_fold")
    const_fold()
    safe_opt_commit("const_fold")
    safe_opt_pass("algebraic")
    algebraic()
    safe_opt_commit("algebraic")
    safe_opt_pass("strength")
    strength()
    safe_opt_commit("strength")
    safe_opt_pass("peephole_extra")
    peephole_extra()
    safe_opt_commit("peephole_extra")
    safe_opt_pass("load_fwd")
    load_fwd()
    safe_opt_commit("load_fwd")
    safe_opt_pass("dead_store")
    dead_store()
    safe_opt_commit("dead_store")
    safe_opt_pass("branch_simplify")
    branch_simplify()
    safe_opt_commit("branch_simplify")
    safe_opt_pass("jump_thread")
    jump_thread()
    safe_opt_commit("jump_thread")
    safe_opt_pass("tail_call")
    tail_call()
    safe_opt_commit("tail_call")
    safe_opt_pass("dce")
    dce()
    safe_opt_commit("dce")
    safe_opt_pass("dead_pure")
    dead_pure()
    safe_opt_commit("dead_pure")
    safe_opt_pass("fuse_inc_jle")
    fuse_inc_jle()
    safe_opt_commit("fuse_inc_jle")
    return true
break

fun optimize_medium -> bool;
    numeric rnd = 0
    while rnd < 2;
        optimize_round()
        rnd = rnd + 1
    break
    const_fold()
    algebraic()
    strength()
    peephole_extra()
    dead_pure()
    fuse_inc_jle()
    dce()
    dead_pure()
    return true

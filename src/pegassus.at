    log "hello greeter ask loop fact cmp bits stack bench fwd named constx"
    return true
break


fun escape_str -> text text s;
    text out = ""
    numeric i = 0
    numeric n = length(s)
    while i < n;
        text c = s[i]
        if c == "
";
            out = out + "{{NL}}"
        else;
            out = out + c
        break
        i = i + 1
    break
    return out
break

fun unescape_str -> text text s;
    text out = ""
    numeric i = 0
    numeric n = length(s)
    while i < n;
        if i + 5 < n;
            if s[i] == "{";
                if s[i + 1] == "{";
                    if s[i + 2] == "N";
                        if s[i + 3] == "L";
                            if s[i + 4] == "}";
                                if s[i + 5] == "}";
                                    out = out + "
"
                                    i = i + 6
                                else;
                                    out = out + s[i]
                                    i = i + 1
                                break
                            else;
                                out = out + s[i]
                                i = i + 1
                            break
                        else;
                            out = out + s[i]
                            i = i + 1
                        break
                    else;
                        out = out + s[i]
                        i = i + 1
                    break
                else;
                    out = out + s[i]
                    i = i + 1
                break
            else;
                out = out + s[i]
                i = i + 1
            break
        else;
            out = out + s[i]
            i = i + 1
        break
    break
    return out
break

fun cache_path -> text text path;
    if opt_level == 0;
        return path + ".pegc"
    break
    if opt_level == 1;
        return path + ".pegc.O1"
    break
    if opt_level == 2;
        return path + ".pegc.O2"
    break
    return path + ".pegc.bare"
break

fun save_cache -> bool text path;
    text cp = cache_path(path)
    file f = open_write(cp)
    write(f, "PEGC4\n")
    write(f, "" + PEGC_VERSION + "\n")
    write(f, "" + opt_level + "\n")
    write(f, "" + src_hash + "\n")
    write(f, "" + opt_len + "\n")
    write(f, "" + code_len + "\n")
    write(f, "" + str_count + "\n")
    numeric i = 0
    while i < str_count;
        write(f, escape_str(strpool[i]) + "\n")
        i = i + 1
    break
    i = 0
    while i < opt_len;
        write(f, "" + p#read(optc, i) + "\n")
        i = i + 1
    break
    i = 0
    while i < code_len;
        write(f, "" + p#read(code, i) + "\n")
        i = i + 1
    break
    i = 0
    while i < code_len;
        write(f, "" + p#read(codeline, i) + "\n")
        i = i + 1
    break
    close(f)
    return true
break

fun load_cache -> bool text path;
    text cp = cache_path(path)
    if file_exists(cp) == false;
        return false
    break
    file f = open(cp)
    text magic = read_line(f)
    if magic != "PEGC4";
        if magic != "PEGC3";
            close(f)
            return false
        break
    break
    text vs = read_line(f)
    if is_number_token(vs) == false;
        close(f)
        return false
    break
    if parse_num(vs) != PEGC_VERSION;
        close(f)
        return false
    break
    if magic == "PEGC4";
        text olsv = read_line(f)
        if is_number_token(olsv) == false;
            close(f)
            return false
        break
        if parse_num(olsv) != opt_level;
            close(f)
            return false
        break
    break
    text hs = read_line(f)
    if is_number_token(hs) == false;
        close(f)
        return false
    break
    if parse_num(hs) != src_hash;
        close(f)
        return false
    break
    text ols = read_line(f)
    text cls = read_line(f)
    text scs = read_line(f)
    if is_number_token(scs) == false;
        close(f)
        return false
    break
    numeric sc = parse_num(scs)
    if sc < 0;
        close(f)
        return false
    break
    if sc > CODE_MAX;
        close(f)
        return false
    break
    strpool = []
    str_count = 0
    numeric si = 0
    while si < sc;
        text sl = read_line(f)
        strpool.append(unescape_str(sl))
        str_count = str_count + 1
        si = si + 1
    break
    if is_number_token(ols) == false;
        close(f)
        return false
    break
    if is_number_token(cls) == false;
        close(f)
        return false
    break
    numeric ol = parse_num(ols)
    numeric cl = parse_num(cls)
    if ol < 1;
        close(f)
        return false
    break
    if ol >= CODE_MAX;
        close(f)
        return false
    break
    if cl < 1;
        close(f)
        return false
    break
    if cl >= CODE_MAX;
        close(f)
        return false
    break
    numeric i = 0
    while i < ol;
        text line = read_line(f)
        if is_number_token(line) == false;
            close(f)
            return false
        break
        p#write(optc, i, parse_num(line))
        i = i + 1
    break
    i = 0
    while i < cl;
        text line2 = read_line(f)
        if is_number_token(line2) == false;
            close(f)
            return false
        break
        p#write(code, i, parse_num(line2))
        i = i + 1
    break
    i = 0
    while i < cl;
        text line3 = read_line(f)
        if is_number_token(line3) == false;
            close(f)
            return false
        break
        p#write(codeline, i, parse_num(line3))
        i = i + 1
    break
    close(f)
    opt_len = ol
    code_len = cl
    xc = []
    i = 0
    while i < ol;
        xc.append(p#read(optc, i))
        i = i + 1
    break
    if verify_bytecode() == false;
        return false
    break
    cache_hits = 1
    return true
break

fun do_check -> numeric text name;
    clear_program()
    text path = resolve_path(name)
    if load_source(path) == false;
        return 1
    break
    if assemble() == false;
        return 1
    break
    optimize()
    if verify_bytecode() == false;
        return 1
    break
    text olname = "normal"
    if opt_level == 1;
        olname = "medium"
    elif opt_level == 2;
        olname = "aggressive"
    elif opt_level >= 3;
        olname = "bare"
    break
    log "ok: " + path + " (" + code_len + " slots, " + opt_len + " optimizados, nivel=" + olname + ", eliminados=" + opt_removed + ")"
    return 0
break

fun do_run -> numeric text name;
    clear_program()
    cache_hits = 0
    text path = resolve_path(name)
    if load_source(path) == false;
        return 1
    break
    if load_cache(path);
        return run_cached()
    break
    if assemble() == false;
        return 1
    break
    optimize()
    if verify_bytecode() == false;
        return 1
    break
    save_cache(path)
    return run_cached()
break

fun do_dis -> numeric text name;
    clear_program()
    text path = resolve_path(name)
    if load_source(path) == false;
        return 1
    break
    if assemble() == false;
        return 1
    break
    log "=== " + path + " slots=" + code_len + " ==="
    disassemble()
    return 0
break

fun dump_opt_ir -> bool text outpath;
    file f = open_write(outpath)
    write(f, "; pegassus optimized IR level=" + opt_level + " removed=" + opt_removed + "\n")
    numeric i = 0
    while i < opt_len;
        numeric op = p#read(optc, i)
        text line = op_name(op)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if w > 0;
            numeric k = 1
            while k <= w;
                line = line + " " + p#read(optc, i + k)
                k = k + 1
            break
        break
        write(f, line + "\n")
        i = i + w + 1
    break
    close(f)
    return true
break

fun asm_emit_op -> bool file f, numeric op, numeric i;
    numeric w = opcode_width(op)
    if w < 0;
        w = 0
    break
    if op == OP_HALT;
        write(f, "    ; halt\n")
        write(f, "    xor rdi, rdi\n")
        write(f, "    call __peg_exit\n")
    elif op == OP_HALTC;
        write(f, "    ; haltc\n")
        write(f, "    pop rdi\n")
        write(f, "    call __peg_exit\n")
    elif op == OP_PUSH;
        write(f, "    ; push " + p#read(optc, i + 1) + "\n")
        write(f, "    mov rax, " + p#read(optc, i + 1) + "\n")
        write(f, "    push rax\n")
    elif op == OP_POP;
        write(f, "    ; pop\n")
        write(f, "    pop rax\n")
    elif op == OP_DUP;
        write(f, "    ; dup\n")
        write(f, "    mov rax, [rsp]\n")
        write(f, "    push rax\n")
    elif op == OP_SWAP;
        write(f, "    ; swap\n")
        write(f, "    pop rax\n")
        write(f, "    pop rbx\n")
        write(f, "    push rax\n")
        write(f, "    push rbx\n")
    elif op == OP_OVER;
        write(f, "    ; over\n")
        write(f, "    mov rax, [rsp+8]\n")
        write(f, "    push rax\n")
    elif op == OP_ADD;
        write(f, "    ; add\n")
        write(f, "    pop rax\n")
        write(f, "    add [rsp], rax\n")
    elif op == OP_SUB;
        write(f, "    ; sub\n")
        write(f, "    pop rax\n")
        write(f, "    sub [rsp], rax\n")
    elif op == OP_MUL;
        write(f, "    ; mul\n")
        write(f, "    pop rax\n")
        write(f, "    imul rax, [rsp]\n")
        write(f, "    mov [rsp], rax\n")
    elif op == OP_DIV;
        write(f, "    ; div\n")
        write(f, "    pop rbx\n")
        write(f, "    pop rax\n")
        write(f, "    cqo\n")
        write(f, "    idiv rbx\n")
        write(f, "    push rax\n")
    elif op == OP_MOD;
        write(f, "    ; mod\n")
        write(f, "    pop rbx\n")
        write(f, "    pop rax\n")
        write(f, "    cqo\n")
        write(f, "    idiv rbx\n")
        write(f, "    push rdx\n")
    elif op == OP_NEG;
        write(f, "    ; neg\n")
        write(f, "    neg qword [rsp]\n")
    elif op == OP_NOT;
        write(f, "    ; not (logical)\n")
        write(f, "    pop rax\n")
        write(f, "    test rax, rax\n")
        write(f, "    setz al\n")
        write(f, "    movzx rax, al\n")
        write(f, "    push rax\n")
    elif op == OP_AND;
        write(f, "    ; and\n")
        write(f, "    pop rax\n")
        write(f, "    and [rsp], rax\n")
    elif op == OP_OR;
        write(f, "    ; or\n")
        write(f, "    pop rax\n")
        write(f, "    or [rsp], rax\n")
    elif op == OP_XOR;
        write(f, "    ; xor\n")
        write(f, "    pop rax\n")
        write(f, "    xor [rsp], rax\n")
    elif op == OP_SHL;
        write(f, "    ; shl\n")
        write(f, "    pop rcx\n")
        write(f, "    pop rax\n")
        write(f, "    shl rax, cl\n")
        write(f, "    push rax\n")
    elif op == OP_SHR;
        write(f, "    ; shr\n")
        write(f, "    pop rcx\n")
        write(f, "    pop rax\n")
        write(f, "    shr rax, cl\n")
        write(f, "    push rax\n")
    elif op == OP_EQ;
        write(f, "    ; eq\n")
        write(f, "    pop rax\n")
        write(f, "    pop rbx\n")
        write(f, "    cmp rbx, rax\n")
        write(f, "    sete al\n")
        write(f, "    movzx rax, al\n")
        write(f, "    push rax\n")
    elif op == OP_NE;
        write(f, "    ; ne\n")
        write(f, "    pop rax\n")
        write(f, "    pop rbx\n")
        write(f, "    cmp rbx, rax\n")
        write(f, "    setne al\n")
        write(f, "    movzx rax, al\n")
        write(f, "    push rax\n")
    elif op == OP_LT;
        write(f, "    ; lt\n")
        write(f, "    pop rax\n")
        write(f, "    pop rbx\n")
        write(f, "    cmp rbx, rax\n")
        write(f, "    setl al\n")
        write(f, "    movzx rax, al\n")
        write(f, "    push rax\n")
    elif op == OP_LE;
        write(f, "    ; le\n")
        write(f, "    pop rax\n")
        write(f, "    pop rbx\n")
        write(f, "    cmp rbx, rax\n")
        write(f, "    setle al\n")
        write(f, "    movzx rax, al\n")
        write(f, "    push rax\n")
    elif op == OP_GT;
        write(f, "    ; gt\n")
        write(f, "    pop rax\n")
        write(f, "    pop rbx\n")
        write(f, "    cmp rbx, rax\n")
        write(f, "    setg al\n")
        write(f, "    movzx rax, al\n")
        write(f, "    push rax\n")
    elif op == OP_GE;
        write(f, "    ; ge\n")
        write(f, "    pop rax\n")
        write(f, "    pop rbx\n")
        write(f, "    cmp rbx, rax\n")
        write(f, "    setge al\n")
        write(f, "    movzx rax, al\n")
        write(f, "    push rax\n")
    elif op == OP_JMP;
        write(f, "    ; jmp\n")
        write(f, "    jmp .L" + p#read(optc, i + 1) + "\n")
    elif op == OP_JZ;
        write(f, "    ; jz\n")
        write(f, "    pop rax\n")
        write(f, "    test rax, rax\n")
        write(f, "    jz .L" + p#read(optc, i + 1) + "\n")
    elif op == OP_JNZ;
        write(f, "    ; jnz\n")
        write(f, "    pop rax\n")
        write(f, "    test rax, rax\n")
        write(f, "    jnz .L" + p#read(optc, i + 1) + "\n")
    elif op == OP_LOAD;
        numeric ls = p#read(optc, i + 1)
        write(f, "    ; load " + ls + "\n")
        if ls == 0;
            write(f, "    push r8\n")
        elif ls == 1;
            write(f, "    push r9\n")
        elif ls == 2;
            write(f, "    push r10\n")
        elif ls == 3;
            write(f, "    push r11\n")
        elif ls == 4;
            write(f, "    push r12\n")
        elif ls == 5;
            write(f, "    push r13\n")
        elif ls == 6;
            write(f, "    push rbx\n")
        elif ls == 7;
            write(f, "    push r15\n")
        else;
            write(f, "    mov rax, [locals + 8*" + ls + "]\n")
            write(f, "    push rax\n")
        break
    elif op == OP_STORE;
        numeric ss = p#read(optc, i + 1)
        write(f, "    ; store " + ss + "\n")
        if ss == 0;
            write(f, "    pop r8\n")
        elif ss == 1;
            write(f, "    pop r9\n")
        elif ss == 2;
            write(f, "    pop r10\n")
        elif ss == 3;
            write(f, "    pop r11\n")
        elif ss == 4;
            write(f, "    pop r12\n")
        elif ss == 5;
            write(f, "    pop r13\n")
        elif ss == 6;
            write(f, "    pop rbx\n")
        elif ss == 7;
            write(f, "    pop r15\n")
        else;
            write(f, "    pop rax\n")
            write(f, "    mov [locals + 8*" + ss + "], rax\n")
        break
    elif op == OP_PRINT;
        write(f, "    ; print\n")
        write(f, "    pop rsi\n")
        write(f, "    call __peg_print_int\n")
    elif op == OP_IADD_LL;
        numeric da = p#read(optc, i + 1)
        numeric db = p#read(optc, i + 2)
        write(f, "    ; iadd_ll " + da + " " + db + "\n")
        if db == 0;
            write(f, "    mov rax, r8\n")
        elif db == 1;
            write(f, "    mov rax, r9\n")
        elif db == 2;
            write(f, "    mov rax, r10\n")
        elif db == 3;
            write(f, "    mov rax, r11\n")
        else;
            write(f, "    mov rax, [locals + 8*" + db + "]\n")
        break
        if da == 0;
            write(f, "    add r8, rax\n")
        elif da == 1;
            write(f, "    add r9, rax\n")
        elif da == 2;
            write(f, "    add r10, rax\n")
        elif da == 3;
            write(f, "    add r11, rax\n")
        else;
            write(f, "    add [locals + 8*" + da + "], rax\n")
        break
    elif op == OP_ISUB_LL;
        write(f, "    ; isub_ll\n")
        write(f, "    mov rax, [locals + 8*" + p#read(optc, i + 2) + "]\n")
        write(f, "    sub [locals + 8*" + p#read(optc, i + 1) + "], rax\n")
    elif op == OP_IMUL_LL;
        write(f, "    ; imul_ll\n")
        write(f, "    mov rax, [locals + 8*" + p#read(optc, i + 1) + "]\n")
        write(f, "    imul rax, [locals + 8*" + p#read(optc, i + 2) + "]\n")
        write(f, "    mov [locals + 8*" + p#read(optc, i + 1) + "], rax\n")
    elif op == OP_INC_L;
        numeric ic = p#read(optc, i + 1)
        write(f, "    ; inc_l " + ic + "\n")
        if ic == 0;
            write(f, "    inc r8\n")
        elif ic == 1;
            write(f, "    inc r9\n")
        elif ic == 2;
            write(f, "    inc r10\n")
        elif ic == 3;
            write(f, "    inc r11\n")
        else;
            write(f, "    inc qword [locals + 8*" + ic + "]\n")
        break
    elif op == OP_DEC_L;
        write(f, "    ; dec_l " + p#read(optc, i + 1) + "\n")
        write(f, "    dec qword [locals + 8*" + p#read(optc, i + 1) + "]\n")
    elif op == OP_IADD_LN;
        write(f, "    ; iadd_ln " + p#read(optc, i + 1) + " " + p#read(optc, i + 2) + "\n")
        write(f, "    add qword [locals + 8*" + p#read(optc, i + 1) + "], " + p#read(optc, i + 2) + "\n")
    elif op == OP_SUB_LN;
        write(f, "    ; sub_ln\n")
        write(f, "    sub qword [locals + 8*" + p#read(optc, i + 1) + "], " + p#read(optc, i + 2) + "\n")
    elif op == OP_MUL_LN;
        write(f, "    ; mul_ln\n")
        write(f, "    mov rax, [locals + 8*" + p#read(optc, i + 1) + "]\n")
        write(f, "    imul rax, " + p#read(optc, i + 2) + "\n")
        write(f, "    mov [locals + 8*" + p#read(optc, i + 1) + "], rax\n")
    elif op == OP_JLE_LN;
        numeric js = p#read(optc, i + 1)
        numeric jn = p#read(optc, i + 2)
        numeric jt = p#read(optc, i + 3)
        write(f, "    ; jle_ln\n")
        if js == 0;
            write(f, "    cmp r8, " + jn + "\n")
        elif js == 1;
            write(f, "    cmp r9, " + jn + "\n")
        elif js == 2;
            write(f, "    cmp r10, " + jn + "\n")
        elif js == 3;
            write(f, "    cmp r11, " + jn + "\n")
        else;
            write(f, "    mov rax, [locals + 8*" + js + "]\n")
            write(f, "    cmp rax, " + jn + "\n")
        break
        write(f, "    jle .L" + jt + "\n")
    elif op == OP_JGT_LN;
        write(f, "    mov rax, [locals + 8*" + p#read(optc, i + 1) + "]\n")
        write(f, "    cmp rax, " + p#read(optc, i + 2) + "\n")
        write(f, "    jg .L" + p#read(optc, i + 3) + "\n")
    elif op == OP_JLT_LN;
        write(f, "    mov rax, [locals + 8*" + p#read(optc, i + 1) + "]\n")
        write(f, "    cmp rax, " + p#read(optc, i + 2) + "\n")
        write(f, "    jl .L" + p#read(optc, i + 3) + "\n")
    elif op == OP_JGE_LN;
        write(f, "    mov rax, [locals + 8*" + p#read(optc, i + 1) + "]\n")
        write(f, "    cmp rax, " + p#read(optc, i + 2) + "\n")
        write(f, "    jge .L" + p#read(optc, i + 3) + "\n")
    elif op == OP_CALL;
        write(f, "    ; call\n")
        write(f, "    lea rax, [rel .L" + (i + w + 1) + "]\n")
        write(f, "    mov [r14], rax\n")
        write(f, "    add r14, 8\n")
        write(f, "    jmp .L" + p#read(optc, i + 1) + "\n")
    elif op == OP_RET;
        write(f, "    ; ret\n")
        write(f, "    sub r14, 8\n")
        write(f, "    mov rax, [r14]\n")
        write(f, "    jmp rax\n")
    else;
        write(f, "    ; TODO op " + op + " (" + op_name(op) + ")\n")
        write(f, "    ; no soportado en asm emitter\n")
    break
    return true
break

fun do_asm -> numeric text name;
    clear_program()
    text path = resolve_path(name)
    if load_source(path) == false;
        return 1
    break
    if assemble() == false;
        return 1
    break
    optimize()
    if verify_bytecode() == false;
        return 1
    break
    text outp = path + ".asm"
    file f = open_write(outp)
    text ost = "linux"
    if asm_os == 1;
        ost = "windows"
    elif asm_os == 2;
        ost = "macos"
    break
    write(f, "; Pegassus IR -> x86-64 NASM (" + ost + ")\n")
    write(f, "; source: " + path + "\n")
    write(f, "; opt_level=" + opt_level + " removed=" + opt_removed + "\n")
    write(f, "; target: " + ost + "\n")
    if asm_os == 0;
        write(f, "; build linux:\n")
        write(f, ";   nasm -f elf64 " + outp + " -o prog.o && ld prog.o -o prog && ./prog\n")
    elif asm_os == 1;
        write(f, "; build windows (MinGW / nasm):\n")
        write(f, ";   nasm -f win64 " + outp + " -o prog.obj\n")
        write(f, ";   gcc prog.obj -o prog.exe -lkernel32 -lmsvcrt\n")
        write(f, ";   (o) golink /entry:main prog.obj msvcrt.dll kernel32.dll\n")
    else;
        write(f, "; build macos:\n")
        write(f, ";   nasm -f macho64 " + outp + " -o prog.o\n")
        write(f, ";   ld -macos_version_min 10.13 -lSystem -o prog prog.o\n")
        write(f, ";   ./prog\n")
    break
    write(f, "\n")
    write(f, "bits 64\n")
    write(f, "default rel\n")
    write(f, "\n")
    if asm_os == 2;
        write(f, "section __DATA,__bss\n")
    else;
        write(f, "section .bss\n")
    break
    write(f, "align 8\n")
    write(f, "locals: resq 2048\n")
    write(f, "printbuf: resb 32\n")
    write(f, "retstack: resq 512\n")
    write(f, "\n")
    if asm_os == 1;
        write(f, "section .data\n")
        write(f, "fmt_int: db \"%lld\", 10, 0\n")
        write(f, "\n")
    break
    if asm_os == 2;
        write(f, "section __TEXT,__text\n")
    else;
        write(f, "section .text\n")
    break
    if asm_os == 0;
        write(f, "global _start\n")
    elif asm_os == 1;
        write(f, "global main\n")
        write(f, "extern printf\n")
        write(f, "extern ExitProcess\n")
    else;
        write(f, "global _main\n")
    break
    write(f, "\n")
    write(f, "__peg_exit:\n")
    write(f, "    ; rdi = code\n")
    if asm_os == 0;
        write(f, "    mov rax, 60\n")
        write(f, "    syscall\n")
    elif asm_os == 1;
        write(f, "    sub rsp, 40\n")
        write(f, "    mov rcx, rdi\n")
        write(f, "    call ExitProcess\n")
    else;
        write(f, "    mov rax, 0x2000001\n")
        write(f, "    syscall\n")
    break
    write(f, "\n")
    write(f, "__peg_print_int:\n")
    write(f, "    ; rsi = value\n")
    if asm_os == 1;
        write(f, "    sub rsp, 40\n")
        write(f, "    mov rcx, fmt_int\n")
        write(f, "    mov rdx, rsi\n")
        write(f, "    call printf\n")
        write(f, "    add rsp, 40\n")
        write(f, "    ret\n")
    else;
        write(f, "    push rbx\n")
        write(f, "    push rcx\n")
        write(f, "    push rdx\n")
        write(f, "    push r8\n")
        write(f, "    mov rax, rsi\n")
        write(f, "    mov rbx, 10\n")
        write(f, "    mov rcx, printbuf+31\n")
        write(f, "    mov byte [rcx], 10\n")
        write(f, "    dec rcx\n")
        write(f, "    test rax, rax\n")
        write(f, "    jns .pos\n")
        write(f, "    neg rax\n")
        write(f, "    mov r8, 1\n")
        write(f, "    jmp .digits\n")
        write(f, ".pos:\n")
        write(f, "    xor r8, r8\n")
        write(f, ".digits:\n")
        write(f, "    xor rdx, rdx\n")
        write(f, "    div rbx\n")
        write(f, "    add dl, 48\n")
        write(f, "    mov [rcx], dl\n")
        write(f, "    dec rcx\n")
        write(f, "    test rax, rax\n")
        write(f, "    jnz .digits\n")
        write(f, "    test r8, r8\n")
        write(f, "    jz .write\n")
        write(f, "    mov byte [rcx], 45\n")
        write(f, "    dec rcx\n")
        write(f, ".write:\n")
        write(f, "    inc rcx\n")
        if asm_os == 0;
            write(f, "    mov rax, 1\n")
            write(f, "    mov rdi, 1\n")
            write(f, "    mov rsi, rcx\n")
            write(f, "    mov rdx, printbuf+32\n")
            write(f, "    sub rdx, rcx\n")
            write(f, "    syscall\n")
        else;
            write(f, "    mov rax, 0x2000004\n")
            write(f, "    mov rdi, 1\n")
            write(f, "    mov rsi, rcx\n")
            write(f, "    mov rdx, printbuf+32\n")
            write(f, "    sub rdx, rcx\n")
            write(f, "    syscall\n")
        break
        write(f, "    pop r8\n")
        write(f, "    pop rdx\n")
        write(f, "    pop rcx\n")
        write(f, "    pop rbx\n")
        write(f, "    ret\n")
    break
    write(f, "\n")
    if asm_os == 0;
        write(f, "_start:\n")
    elif asm_os == 1;
        write(f, "main:\n")
        write(f, "    sub rsp, 40\n")
    else;
        write(f, "_main:\n")
    break
    write(f, "    ; locals en .bss a 0\n")
    write(f, "    lea r14, [retstack]\n")
    write(f, "    xor r8, r8\n")
    write(f, "    xor r9, r9\n")
    write(f, "    xor r10, r10\n")
    write(f, "    xor r11, r11\n")
    write(f, "    xor r12, r12\n")
    write(f, "    xor r13, r13\n")
    write(f, "    xor rbx, rbx\n")
    write(f, "    xor r15, r15\n")
    numeric i = 0
    while i < opt_len;
        write(f, ".L" + i + ":\n")
        numeric op = p#read(optc, i)
        asm_emit_op(f, op, i)
        numeric ww = opcode_width(op)
        if ww < 0;
            ww = 0
        break
        i = i + ww + 1
    break
    write(f, "    ; fallback exit\n")
    write(f, "    xor rdi, rdi\n")
    write(f, "    call __peg_exit\n")
    close(f)
    text olname = "normal"
    if opt_level == 1;
        olname = "medium"
    elif opt_level == 2;
        olname = "aggressive"
    elif opt_level >= 3;
        olname = "bare"
    break
    log "asm: " + outp + " (" + opt_len + " ops IR, nivel=" + olname + ", os=" + ost + ", eliminados=" + opt_removed + ")"
    if asm_os == 0;
        log "  nasm -f elf64 " + outp + " -o prog.o && ld prog.o -o prog && ./prog"
    elif asm_os == 1;
        log "  nasm -f win64 " + outp + " -o prog.obj && gcc prog.obj -o prog.exe -lkernel32 -lmsvcrt"
    else;
        log "  nasm -f macho64 " + outp + " -o prog.o && ld -lSystem -o prog prog.o && ./prog"
    break
    return 0
break




fun bin_new -> bool;
    binbuf = []
    return true
break

fun bin_b -> bool numeric v;
    numeric x = v
    while x < 0;
        x = x + 256
    break
    while x >= 256;
        x = x - 256
    break
    binbuf.append(x)
    return true
break

fun bin_u16 -> bool numeric v;
    numeric x = v % 65536
    if x < 0;
        x = x + 65536
    break
    bin_b(x % 256)
    bin_b((x - (x % 256)) / 256)
    return true
break

fun bin_u32 -> bool numeric v;
    numeric x = v
    if x < 0;
        x = x + 4294967296
    break
    numeric b0 = x % 256
    bin_b(b0)
    x = (x - b0) / 256
    numeric b1 = x % 256
    bin_b(b1)
    x = (x - b1) / 256
    numeric b2 = x % 256
    bin_b(b2)
    x = (x - b2) / 256
    bin_b(x % 256)
    return true
break

fun bin_u64 -> bool numeric v;
    bin_u32(v)
    bin_u32(0)
    return true
break

fun bin_i32 -> bool numeric v;
    numeric x = v
    if x < 0;
        x = x + 4294967296
    break
    bin_u32(x)
    return true
break

fun bin_i64_mov_rax -> bool numeric v;
    bin_b(72)
    bin_b(184)
    numeric x = v
    numeric i = 0
    while i < 8;
        numeric b = x
        while b < 0;
            b = b + 256
        break
        while b >= 256;
            b = b - 256
        break
        bin_b(b)
        x = (x - b) / 256
        if x < 0;
            x = 0 - ((0 - x) / 1)
            x = (x - (x % 1))
        break
        i = i + 1
    break
    return true
break

fun bin_emit_imm64 -> bool numeric v;
    numeric x = v
    numeric i = 0
    while i < 8;
        numeric byte = x % 256
        if byte < 0;
            byte = byte + 256
        break
        bin_b(byte)
        x = (x - byte) / 256
        i = i + 1
    break
    return true
break

fun mc_push_imm -> bool numeric v;
    bin_b(72)
    bin_b(184)
    bin_emit_imm64(v)
    bin_b(80)
    return true
break

fun mc_pop_rax -> bool;
    bin_b(88)
    return true
break

fun mc_push_rax -> bool;
    bin_b(80)
    return true
break

fun mc_add -> bool;
    bin_b(88)
    bin_b(91)
    bin_b(72)
    bin_b(1)
    bin_b(195)
    bin_b(83)
    return true
break

fun mc_sub -> bool;
    bin_b(88)
    bin_b(91)
    bin_b(72)
    bin_b(41)
    bin_b(195)
    bin_b(83)
    return true
break

fun mc_mul -> bool;
    bin_b(88)
    bin_b(91)
    bin_b(72)
    bin_b(15)
    bin_b(175)
    bin_b(216)
    bin_b(83)
    return true
break

fun mc_neg -> bool;
    bin_b(72)
    bin_b(247)
    bin_b(28)
    bin_b(36)
    return true
break

fun mc_load -> bool numeric s;
    bin_b(72)
    bin_b(139)
    bin_b(133)
    bin_i32(0 - (8 * (s + 1)))
    bin_b(80)
    return true
break

fun mc_store -> bool numeric s;
    bin_b(88)
    bin_b(72)
    bin_b(137)
    bin_b(133)
    bin_i32(0 - (8 * (s + 1)))
    return true
break

fun mc_halt_linux -> bool;
    bin_b(72)
    bin_b(49)
    bin_b(255)
    bin_b(72)
    bin_b(199)
    bin_b(192)
    bin_b(60)
    bin_b(0)
    bin_b(0)
    bin_b(0)
    bin_b(15)
    bin_b(5)
    return true
break

fun mc_print_linux -> bool;
    bin_b(88)
    bin_b(72)
    bin_b(137)
    bin_b(198)
    bin_b(232)
    bin_i32(0)
    return true
break

fun mc_prologue -> bool;
    bin_b(85)
    bin_b(72)
    bin_b(137)
    bin_b(229)
    bin_b(72)
    bin_b(129)
    bin_b(236)
    bin_u32(16384)
    return true
break

fun emit_ir_machine -> bool;
    bin_new()
    mc_prologue()
    numeric i = 0
    while i < opt_len;
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if op == OP_PUSH;
            mc_push_imm(p#read(optc, i + 1))
        elif op == OP_POP;
            mc_pop_rax()
        elif op == OP_ADD;
            mc_add()
        elif op == OP_SUB;
            mc_sub()
        elif op == OP_MUL;
            mc_mul()
        elif op == OP_NEG;
            mc_neg()
        elif op == OP_LOAD;
            mc_load(p#read(optc, i + 1))
        elif op == OP_STORE;
            mc_store(p#read(optc, i + 1))
        elif op == OP_DUP;
            bin_b(88)
            bin_b(80)
            bin_b(80)
        elif op == OP_PRINT;
            bin_b(88)
            bin_b(80)
        elif op == OP_HALT;
            bin_b(88)
            bin_b(72)
            bin_b(137)
            bin_b(199)
            if asm_os == 0;
                bin_b(72)
                bin_b(199)
                bin_b(192)
                bin_b(60)
                bin_b(0)
                bin_b(0)
                bin_b(0)
                bin_b(15)
                bin_b(5)
            elif asm_os == 2;
                bin_b(72)
                bin_b(199)
                bin_b(192)
                bin_b(1)
                bin_b(0)
                bin_b(0)
                bin_b(2)
                bin_b(15)
                bin_b(5)
            else;
                bin_b(195)
            break
        elif op == OP_IADD_LL;
            numeric da = p#read(optc, i + 1)
            numeric db = p#read(optc, i + 2)
            mc_load(db)
            mc_pop_rax()
            bin_b(72)
            bin_b(1)
            bin_b(133)
            bin_i32(0 - (8 * (da + 1)))
        elif op == OP_INC_L;
            numeric ic = p#read(optc, i + 1)
            bin_b(72)
            bin_b(255)
            bin_b(133)
            bin_i32(0 - (8 * (ic + 1)))
        break
        i = i + w + 1
    break
    bin_b(72)
    bin_b(49)
    bin_b(255)
    if asm_os == 0;
        bin_b(72)
        bin_b(199)
        bin_b(192)
        bin_b(60)
        bin_b(0)
        bin_b(0)
        bin_b(0)
        bin_b(15)
        bin_b(5)
    break
    return true
break

fun bin_to_hex -> text;
    text hx = ""
    text digits = "0123456789abcdef"
    numeric i = 0
    while i < length(binbuf);
        numeric v = binbuf[i]
        while v < 0;
            v = v + 256
        break
        while v >= 256;
            v = v - 256
        break
        numeric lo = v % 16
        numeric hi = (v - lo) / 16
        hx = hx + digits[hi] + digits[lo]
        i = i + 1
    break
    return hx
break

fun bin_write_file -> numeric text path;
    text hx = bin_to_hex()
    text hpath = path + ".hex"
    file hf = open_write(hpath)
    write(hf, hx)
    close(hf)
    text py = "python3 -c \"p=open('" + hpath + "').read().strip(); open('" + path + "','wb').write(bytes.fromhex(p))\""
    numeric rc = exec(py)
    if rc != 0;
        py = "python -c \"p=open('" + hpath + "').read().strip(); open('" + path + "','wb').write(bytes.fromhex(p))\""
        rc = exec(py)
    break
    if rc != 0;
        log "build ERROR: falta python3 solo para volcar bytes (Altair no escribe binario nativo)"
        return 1
    break
    return 0
break

fun elf_wrap -> bool;
    list code = binbuf
    numeric code_sz = length(code)
    numeric phoff = 64
    numeric entry = 64 + 56
    numeric filesz = entry + code_sz
    numeric memsz = filesz + 16384
    bin_new()
    bin_b(127)
    bin_b(69)
    bin_b(76)
    bin_b(70)
    bin_b(2)
    bin_b(1)
    bin_b(1)
    bin_b(0)
    bin_u64(0)
    bin_u16(2)
    bin_u16(62)
    bin_u32(1)
    bin_u64(4194304 + entry)
    bin_u64(phoff)
    bin_u64(0)
    bin_u32(0)
    bin_u16(64)
    bin_u16(56)
    bin_u16(1)
    bin_u16(0)
    bin_u16(0)
    bin_u16(0)
    bin_u32(1)
    bin_u32(7)
    bin_u64(0)
    bin_u64(4194304)
    bin_u64(4194304)
    bin_u64(filesz)
    bin_u64(memsz)
    bin_u64(4096)
    numeric i = 0
    while i < code_sz;
        bin_b(code[i])
        i = i + 1
    break
    return true
break

fun pe_wrap -> bool;
    list code = []
    numeric ci = 0
    while ci < length(binbuf);
        code.append(binbuf[ci])
        ci = ci + 1
    break
    numeric code_sz = length(code)
    bin_new()
    bin_b(77)
    bin_b(90)
    numeric i = 0
    while i < 58;
        bin_b(0)
        i = i + 1
    break
    bin_u32(128)
    i = 0
    while i < 64;
        bin_b(0)
        i = i + 1
    break
    bin_b(80)
    bin_b(69)
    bin_b(0)
    bin_b(0)
    bin_u16(34404)
    bin_u16(1)
    bin_u32(0)
    bin_u32(0)
    bin_u32(0)
    bin_u16(240)
    bin_u16(35)
    bin_u16(267)
    bin_b(2)
    bin_b(35)
    bin_u32(code_sz + 512)
    bin_u32(0)
    bin_u32(0)
    bin_u32(4096)
    bin_u32(4096)
    bin_u32(4096)
    bin_u32(4096)
    bin_u32(65536)
    bin_u32(4096)
    bin_u32(0)
    bin_u16(2)
    bin_u16(0)
    bin_u32(0)
    bin_u32(0)
    bin_u32(0)
    bin_u32(0)
    bin_u16(0)
    bin_u16(0)
    bin_u32(0)
    bin_u32(1024 + code_sz)
    bin_u32(512)
    bin_u32(0)
    bin_u16(2)
    bin_u16(0)
    bin_u64(0)
    bin_u64(0)
    bin_u64(0)
    bin_u64(0)
    bin_u32(0)
    bin_u32(0)
    i = 0
    while i < 128;
        bin_b(0)
        i = i + 1
    break
    i = 0
    while i < code_sz;
        bin_b(code[i])
        i = i + 1
    break
    return true
break

fun macho_wrap -> bool;
    list code = []
    numeric ci = 0
    while ci < length(binbuf);
        code.append(binbuf[ci])
        ci = ci + 1
    break
    numeric code_sz = length(code)
    bin_new()
    bin_u32(4277009103)
    bin_u32(16777223)
    bin_u32(1)
    bin_u32(5)
    bin_u32(1)
    bin_u32(0)
    bin_u32(0)
    bin_u32(0)
    numeric i = 0
    while i < code_sz;
        bin_b(code[i])
        i = i + 1
    break
    return true
break

fun do_build -> numeric text name;
    clear_program()
    text path = resolve_path(name)
    if load_source(path) == false;
        return 1
    break
    if assemble() == false;
        return 1
    break
    optimize()
    if verify_bytecode() == false;
        return 1
    break
    text base = path
    numeric ln = length(path)
    if ln > 3;
        if path[ln - 3] == ".";
            base = ""
            numeric k = 0
            while k < ln - 3;
                base = base + path[k]
                k = k + 1
            break
        break
    break
    text bcpath = base + ".pegbc"
    file bf = open_write(bcpath)
    numeric i = 0
    numeric first = 1
    while i < opt_len;
        numeric op = p#read(optc, i)
        numeric w = opcode_width(op)
        if w < 0;
            w = 0
        break
        if first == 0;
            write(bf, " ")
        break
        first = 0
        write(bf, "" + op)
        if w >= 1;
            write(bf, " " + p#read(optc, i + 1))
        break
        if w >= 2;
            write(bf, " " + p#read(optc, i + 2))
        break
        if w >= 3;
            write(bf, " " + p#read(optc, i + 3))
        break
        i = i + w + 1
    break
    write(bf, "\n")
    close(bf)
    text outbin = base
    text osflag = "--linux"
    if asm_os == 1;
        outbin = base + ".exe"
        osflag = "--windows"
    elif asm_os == 2;
        osflag = "--macos"
    break
    text cmd = "pegbin " + osflag + " " + outbin + " " + bcpath
    log "build: IR opt -> " + bcpath + " -> pegbin " + osflag
    numeric rc = exec(cmd)
    if rc != 0;
        cmd = "./pegbin " + osflag + " " + outbin + " " + bcpath
        rc = exec(cmd)
    break
    if rc != 0;
        log "build ERROR: no se encontro pegbin (compila pegbin.c: gcc -O2 -o pegbin pegbin.c)"
        log "  y ponlo en PATH o junto al .ir"
        return 1
    break
    text ol = "normal"
    if opt_level == 1;
        ol = "medium"
    elif opt_level == 2;
        ol = "aggressive"
    elif opt_level >= 3;
        ol = "bare"
    break
    if asm_os != 1;
        exec("chmod +x " + outbin)
    break
    log "build OK: " + outbin + " (" + ol + ", -" + opt_removed + " ops)"
    return 0
break



fun do_testsuite -> numeric;
    log "Pegassus testsuite (O0..bare)"
    numeric fails = 0
    numeric li = 0
    numeric olv = 0
    text ol = ""
    while li < 4;
        olv = li
        opt_level = olv
        ol = "O" + li
        if li == 3;
            ol = "bare"
            opt_level = 3
        break
        file tf = open_write("_ts_loop.ir")
        write(tf, "push 0")
        write(tf, "\n")
        write(tf, "store 0")
        write(tf, "\n")
        write(tf, "push 1")
        write(tf, "\n")
        write(tf, "store 1")
        write(tf, "\n")
        write(tf, "lab loop")
        write(tf, "\n")
        write(tf, "load 0")
        write(tf, "\n")
        write(tf, "load 1")
        write(tf, "\n")
        write(tf, "add")
        write(tf, "\n")
        write(tf, "store 0")
        write(tf, "\n")
        write(tf, "load 1")
        write(tf, "\n")
        write(tf, "push 1")
        write(tf, "\n")
        write(tf, "add")
        write(tf, "\n")
        write(tf, "store 1")
        write(tf, "\n")
        write(tf, "load 1")
        write(tf, "\n")
        write(tf, "push 10")
        write(tf, "\n")
        write(tf, "le")
        write(tf, "\n")
        write(tf, "jnz loop")
        write(tf, "\n")
        write(tf, "load 0")
        write(tf, "\n")
        write(tf, "print")
        write(tf, "\n")
        write(tf, "halt")
        write(tf, "\n")
        close(tf)
        clear_program()
        if load_source("_ts_loop.ir") == false;
            log "testsuite FAIL loop " + ol + " (load)"
            fails = fails + 1
        elif assemble() == false;
            log "testsuite FAIL loop " + ol + " (assemble)"
            fails = fails + 1
        elif optimize() == false;
            log "testsuite FAIL loop " + ol + " (optimize)"
            fails = fails + 1
        elif verify_bytecode() == false;
            log "testsuite FAIL loop " + ol + " (verify)"
            fails = fails + 1
        else;
            log "testsuite OK loop " + ol
        break
        file te = open_write("_ts_eq.ir")
        write(te, "push 5")
        write(te, "\n")
        write(te, "store 0")
        write(te, "\n")
        write(te, "load 0")
        write(te, "\n")
        write(te, "load 0")
        write(te, "\n")
        write(te, "eq")
        write(te, "\n")
        write(te, "print")
        write(te, "\n")
        write(te, "end")
        write(te, "\n")
        close(te)
        clear_program()
        if load_source("_ts_eq.ir") == false;
            fails = fails + 1
        elif assemble() == false;
            fails = fails + 1
        elif optimize() == false;
            log "testsuite FAIL eq " + ol
            fails = fails + 1
        elif verify_bytecode() == false;
            log "testsuite FAIL eq " + ol
            fails = fails + 1
        else;
            log "testsuite OK eq " + ol
        break
        file tc = open_write("_ts_call.ir")
        write(tc, "push 7")
        write(tc, "\n")
        write(tc, "call add1")
        write(tc, "\n")
        write(tc, "print")
        write(tc, "\n")
        write(tc, "end")
        write(tc, "\n")
        write(tc, "lab add1")
        write(tc, "\n")
        write(tc, "push 1")
        write(tc, "\n")
        write(tc, "add")
        write(tc, "\n")
        write(tc, "ret")
        write(tc, "\n")
        close(tc)
        clear_program()
        if load_source("_ts_call.ir") == false;
            fails = fails + 1
        elif assemble() == false;
            fails = fails + 1
        elif optimize() == false;
            log "testsuite FAIL call " + ol
            fails = fails + 1
        elif verify_bytecode() == false;
            log "testsuite FAIL call " + ol
            fails = fails + 1
        else;
            log "testsuite OK call " + ol
        break
        file ti = open_write("_ts_itoa.ir")
        write(ti, "push 42")
        write(ti, "\n")
        write(ti, "itoa")
        write(ti, "\n")
        write(ti, "prints")
        write(ti, "\n")
        write(ti, "pushs \"99\"")
        write(ti, "\n")
        write(ti, "atoi")
        write(ti, "\n")
        write(ti, "print")
        write(ti, "\n")
        write(ti, "end")
        write(ti, "\n")
        close(ti)
        clear_program()
        if load_source("_ts_itoa.ir") == false;
            fails = fails + 1
        elif assemble() == false;
            fails = fails + 1
        elif optimize() == false;
            log "testsuite FAIL itoa " + ol
            fails = fails + 1
        elif verify_bytecode() == false;
            log "testsuite FAIL itoa " + ol
            fails = fails + 1
        else;
            log "testsuite OK itoa " + ol
        break
        li = li + 1
    break
    if fails == 0;
        log "testsuite: all OK"
        return 0
    break
    log "testsuite: FALLS=" + fails
    return 1
break

fun do_test -> numeric text name;
    text path = resolve_path(name)
    text exp = path
    numeric n = length(exp)
    if n > 3;
        if exp[n-3] == ".";
            exp = ""
            numeric k = 0
            while k < n - 3;
                exp = exp + path[k]
                k = k + 1
            break
            exp = exp + ".expected"
        else;
            exp = path + ".expected"
        break
    else;
        exp = path + ".expected"
    break
    if file_exists(exp) == false;
        log "test: falta " + exp
        return 1
    break
    clear_program()
    if load_source(path) == false;
        return 1
    break
    if assemble() == false;
        return 1
    break
    optimize()
    if verify_bytecode() == false;
        return 1
    break
    numeric code = run_cached()
    file ef = open(exp)
    text want = read(ef)
    close(ef)
    want = trim_left(want)
    if code != 0;
        log "test FAIL " + path + " (vm exit=" + code + ")"
        return 1
    break
    log "test OK " + path + " (expected file presente, exit=0)"
    return 0
break

fun do_opt -> numeric text name;
    clear_program()
    text path = resolve_path(name)
    if load_source(path) == false;
        return 1
    break
    if assemble() == false;
        return 1
    break
    optimize()
    if verify_bytecode() == false;
        return 1
    break
    text outp = path + ".opt.ir"
    dump_opt_ir(outp)
    text olname = "normal"
    if opt_level == 1;
        olname = "medium"
    elif opt_level == 2;
        olname = "aggressive"
    elif opt_level >= 3;
        olname = "bare"
    break
    log "escrito: " + outp + " (" + opt_len + " ops, nivel=" + olname + ", eliminados=" + opt_removed + ")"
    return 0
break

fun do_fmt -> numeric text name;
    clear_program()
    text path = resolve_path(name)
    if load_source(path) == false;
        return 1
    break
    text out = ""
    numeric li = 0
    while li < length(src_lines);
        text raw = src_lines[li]
        text line = trim_left(strip_comment(raw))
        if length(line) == 0;
            out = out + "
"
        else;
            text w = first_word(line)
            if w == "lab";
                out = out + "lab " + rest_words(line) + "
"
            elif w == "const";
                out = out + "const " + rest_words(line) + "
"
            else;
                text argt = rest_words(line)
                if length(argt) > 0;
                    out = out + "    " + w + " " + argt + "
"
                else;
                    out = out + "    " + w + "
"
                break
            break
        break
        li = li + 1
    break
    text outp = path + ".fmt.ir"
    file f = open_write(outp)
    write(f, out)
    close(f)
    log "formateado: " + outp
    return 0
break

fun do_repl -> numeric;
    log "Pegassus REPL 1.9.1  (escribe end para salir)"
    clear_program()
    text acc = ""
    numeric running = 1
    while running == 1;
        log "> "
        text line = input("")
        if line == "end";
            running = 0
        elif line == "quit";
            running = 0
        elif line == "dump";
            log "code_len=" + code_len + " opt_len=" + opt_len
        else;
            acc = acc + line + "
"
            src_lines = []
            text cur = ""
            numeric i = 0
            numeric n = length(acc)
            while i < n;
                text c = acc[i]
                if c == "
";
                    src_lines.append(cur)
                    cur = ""
                else;
                    cur = cur + c
                break
                i = i + 1
            break
            if length(cur) > 0;
                src_lines.append(cur)
            break
            code_len = 0
            opt_len = 0
            if assemble();
                optimize()
                if verify_bytecode();
                    run_cached()
                break
            break
        break
    break
    return 0
break

fun boot -> numeric;
    numeric ac = argc()
    opt_level = 0
    asm_os = 0
    numeric ai = 1
    while ai < ac;
        text fl = arg(ai)
        if fl == "--medium";
            opt_level = 1
        elif fl == "-O1";
            opt_level = 1
        elif fl == "--aggressive";
            opt_level = 2
        elif fl == "--agresive";
            opt_level = 2
        elif fl == "-O2";
            opt_level = 2
        elif fl == "--bare";
            opt_level = 3
        elif fl == "-Obare";
            opt_level = 3
        elif fl == "-O3";
            opt_level = 3
        elif fl == "--linux";
            asm_os = 0
        elif fl == "--windows";
            asm_os = 1
        elif fl == "--win";
            asm_os = 1
        elif fl == "--macos";
            asm_os = 2
        elif fl == "--mac";
            asm_os = 2
        elif fl == "--os";
            if ai + 1 < ac;
                text osv = arg(ai + 1)
                if osv == "linux";
                    asm_os = 0
                elif osv == "windows";
                    asm_os = 1
                elif osv == "win";
                    asm_os = 1
                elif osv == "macos";
                    asm_os = 2
                elif osv == "mac";
                    asm_os = 2
                else;
                    log "os desconocido: " + osv + " (linux|windows|macos)"
                break
                ai = ai + 1
            break
        elif fl == "--steps";
            if ai + 1 < ac;
                text sv = arg(ai + 1)
                if is_number_token(sv);
                    max_steps = parse_num(sv)
                break
                ai = ai + 1
            break
        elif fl == "--normal";
            opt_level = 0
        elif fl == "-O0";
            opt_level = 0
        break
        ai = ai + 1
    break
    list args = []
    ai = 1
    while ai < ac;
        text a = arg(ai)
        if a == "--medium";
            numeric _skip = 1
        elif a == "-O1";
            numeric _skip = 1
        elif a == "--aggressive";
            numeric _skip = 1
        elif a == "--agresive";
            numeric _skip = 1
        elif a == "-O2";
            numeric _skip = 1
        elif a == "--bare";
            numeric _skip = 1
        elif a == "-Obare";
            numeric _skip = 1
        elif a == "-O3";
            numeric _skip = 1
        elif a == "--linux";
            numeric _skip = 1
        elif a == "--windows";
            numeric _skip = 1
        elif a == "--win";
            numeric _skip = 1
        elif a == "--macos";
            numeric _skip = 1
        elif a == "--mac";
            numeric _skip = 1
        elif a == "--os";
            numeric _skip = 1
            if ai + 1 < ac;
                ai = ai + 1
            break
        elif a == "--steps";
            numeric _skip = 1
            if ai + 1 < ac;
                ai = ai + 1
            break
        elif a == "--normal";
            numeric _skip = 1
        elif a == "-O0";
            numeric _skip = 1
        else;
            args.append(a)
        break
        ai = ai + 1
    break
    numeric nac = length(args)
    if nac < 1;
        cmd_help()
    else;
        text cmd = args[0]
        if cmd == "help";
            cmd_help()
        elif cmd == "-h";
            cmd_help()
        elif cmd == "--help";
            cmd_help()
        elif cmd == "cmds";
            cmd_cmds()
        elif cmd == "examples";
            cmd_examples()
        elif cmd == "version";
            log "Pegassus 1.9.12"
            log "stack-vm · IR optimizer O0-O3 · asm linux/windows/macos"
            log "source: pegassus.at (Altair)"
        elif cmd == "-v";
            log "Pegassus 1.9.12"
        elif cmd == "clean";
            if nac < 2;
                log "uso: pegassus clean <prog>  (borra el .pegc)"
            else;
                text cpath = resolve_path(args[1])
                text cp = cache_path(cpath)
                if file_exists(cp);
                    delete_file(cp)
                    log "borrado: " + cp
                else;
                    log "no hay cache: " + cp
                break
            break
        elif cmd == "run";
            if nac < 2;
                log "error: falta el programa  |  uso: pegassus [--medium|--aggressive] run <nombre>"
            else;
                do_run(args[1])
            break
        elif cmd == "stats";
            if nac < 2;
                log "error: falta el programa  |  uso: pegassus stats <nombre>"
            else;
                show_stats = 1
                do_run(args[1])
                show_stats = 0
            break
        elif cmd == "check";
            if nac < 2;
                log "error: falta el programa"
            else;
                do_check(args[1])
            break
        elif cmd == "dis";
            if nac < 2;
                log "error: falta el programa"
            else;
                do_dis(args[1])
            break
        elif cmd == "trace";
            if nac < 2;
                log "error: falta el programa  |  uso: pegassus trace <nombre>"
            else;
                trace_mode = 1
                do_run(args[1])
                trace_mode = 0
            break
        elif cmd == "opt";
            if nac < 2;
                log "error: falta el programa  |  uso: pegassus [--medium|--aggressive] opt <nombre>"
            else;
                do_opt(args[1])
            break
        elif cmd == "asm";
            if nac < 2;
                log "uso: pegassus [opts] [--linux|--windows|--macos] asm <prog.ir>"
                log "  transpila IR optimizado a x86-64 NASM (.asm), no ejecuta"
                log "  --linux (defecto)  --windows/--win  --macos/--mac  --os linux|windows|macos"
            else;
                do_asm(args[1])
            break
        elif cmd == "build";
            if nac < 2;
                log "uso: pegassus [opts] [--linux|--windows|--macos] build <prog.ir>"
                log "  genera binario nativo completo: ELF / .exe / Mach-O"
                log "  requiere nasm + ld (linux), nasm + gcc MinGW (windows), nasm + ld/clang (macos)"
            else;
                do_build(args[1])
            break
        elif cmd == "native";
            if nac < 2;
                log "uso: pegassus [opts] [--linux|--windows|--macos] native <prog.ir>"
                log "  alias de build"
            else;
                do_build(args[1])
            break
        elif cmd == "testsuite";
            do_testsuite()
        elif cmd == "test";
            if nac < 2;
                log "uso: pegassus test <prog.ir>   (necesita prog.expected)"
            else;
                do_test(args[1])
            break
        elif cmd == "fmt";
            if nac < 2;
                log "uso: pegassus fmt <prog.ir>"
            else;
                do_fmt(args[1])
            break
        elif cmd == "repl";
            do_repl()
        else;
            do_run(cmd)
        break
    break
    p#free(code)
    p#free(stack)
    p#free(locals)
    p#free(cstack_ip)
    p#free(cstack_fp)
    p#free(labtab)
    p#free(labkey)
    p#free(labused)
    p#free(consttab)
    p#free(constset)
    p#free(constkey)
    p#free(codeline)
    p#free(optc)
    p#free(optbak)
    p#free(remap)
    p#free(boundary)
    return 0
break

boot()
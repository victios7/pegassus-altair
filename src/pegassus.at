fun optimize -> bool;
    opt_removed = 0
    if opt_level == 0;
        peephole()
        if verify_bytecode() == false;
            return false
        break
        return true
    break
    lower_raw()
    if verify_bytecode() == false;
        return false
    break
    if opt_level >= 3;
        optimize_bare()
    elif opt_level >= 2;
        optimize_aggressive()
    elif opt_level >= 1;
        optimize_medium()
    break
    if verify_bytecode() == false;
        return false
    break
    sync_optc_to_code()
    peephole()
    if verify_bytecode() == false;
        return false
    break
    dead_pure()
    if verify_bytecode() == false;
        return false
    break
    if verify_bytecode() == false;
        return false
    break
    sync_optc_to_code()
    peephole()
    if verify_bytecode() == false;
        return false
    break
    dead_pure()
    if verify_bytecode() == false;
        return false
    break
    fuse_inc_jle()
    if verify_bytecode() == false;
        return false
    break
    sync_optc_to_code()
    peephole()
    if verify_bytecode() == false;
        return false
    break
    return true
break


fun run -> numeric;
    optimize()
    return run_cached()
break

fun run_cached -> numeric;
    numeric cl0 = opt_len
    numeric ip = 0
    numeric sp = 0
    numeric fp = 0
    numeric csp = 0
    numeric last_exit = 0
    numeric steps = 0
    numeric _ms = max_steps
    numeric status = 0
    numeric a = 0
    numeric b = 0
    numeric c = 0
    numeric op = 0
    numeric imm = 0
    numeric at = 0
    numeric tos = 0
    numeric has = 0
    numeric L0 = 0
    numeric L1 = 0
    numeric L2 = 0
    numeric L3 = 0
    numeric L4 = 0
    numeric L5 = 0
    numeric L6 = 0
    numeric L7 = 0
    numeric budget = 4096

    while ip < cl0;
        if status != 0;
            ip = cl0
        break
        steps = steps + 1
        if steps >= _ms;
            err_rt("limite de pasos agotado (" + _ms + "). Casi seguro un jmp/jnz sin salida. Revisa el bucle.", ip, sp + has, fp, csp)
            status = 1
            ip = cl0
        break
        budget = budget - 1
        if budget <= 0;
            budget = 4096
        break
        at = ip
        op = xc[ip]
        ip = ip + 1
        if trace_mode == 1;
            text tr = "[" + at + "] " + op_name(op)
            numeric tw = opcode_width(op)
            if tw > 0;
                if ip < cl0;
                    tr = tr + " " + xc[ip]
                break
            break
            tr = tr + " (sp=" + (sp + has) + ")"
            numeric tln = src_at_ip(at)
            if tln > 0;
                tr = tr + " ; L" + tln
                if tln <= length(src_lines);
                    tr = tr + " " + src_lines[tln - 1]
                break
            break
            log tr
        break

        if op == OP_IADD_LL;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            if a == 0;
                if b == 0;
                    L0 = L0 + L0
                elif b == 1;
                    L0 = L0 + L1
                elif b == 2;
                    L0 = L0 + L2
                elif b == 3;
                    L0 = L0 + L3
                else;
                    L0 = L0 + p#read(locals, b)
                break
            elif a == 1;
                if b == 0;
                    L1 = L1 + L0
                elif b == 1;
                    L1 = L1 + L1
                elif b == 2;
                    L1 = L1 + L2
                elif b == 3;
                    L1 = L1 + L3
                else;
                    L1 = L1 + p#read(locals, b)
                break
            else;
                p#write(locals, a, p#read(locals, a) + p#read(locals, b))
            break
        elif op == OP_INC_L;
            a = xc[ip]
            ip = ip + 1
            if a == 0;
                L0 = L0 + 1
            elif a == 1;
                L1 = L1 + 1
            elif a == 2;
                L2 = L2 + 1
            elif a == 3;
                L3 = L3 + 1
            elif a == 4;
                L4 = L4 + 1
            elif a == 5;
                L5 = L5 + 1
            elif a == 6;
                L6 = L6 + 1
            elif a == 7;
                L7 = L7 + 1
            else;
                p#write(locals, a, p#read(locals, a) + 1)
            break
        elif op == OP_JLE_LN;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            imm = xc[ip]
            ip = ip + 1
            c = 0
            if a == 0;
                c = L0
            elif a == 1;
                c = L1
            elif a == 2;
                c = L2
            elif a == 3;
                c = L3
            else;
                c = p#read(locals, a)
            break
            if c < b;
                ip = imm
            elif c == b;
                ip = imm
            break
        elif op == OP_LOAD;
            if sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (load): limite de " + STACK_MAX + " valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                imm = xc[ip]
                ip = ip + 1
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                break
                if imm == 0;
                    tos = L0
                elif imm == 1;
                    tos = L1
                elif imm == 2;
                    tos = L2
                elif imm == 3;
                    tos = L3
                elif imm == 4;
                    tos = L4
                elif imm == 5;
                    tos = L5
                elif imm == 6;
                    tos = L6
                elif imm == 7;
                    tos = L7
                else;
                    tos = p#read(locals, imm)
                break
                has = 1
            break
        elif op == OP_PUSH;
            if sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (push): limite de " + STACK_MAX + " valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                imm = xc[ip]
                ip = ip + 1
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                break
                tos = imm
                has = 1
            break
        elif op == OP_STORE;
            imm = xc[ip]
            ip = ip + 1
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if imm == 0;
                L0 = a
            elif imm == 1;
                L1 = a
            elif imm == 2;
                L2 = a
            elif imm == 3;
                L3 = a
            elif imm == 4;
                L4 = a
            elif imm == 5;
                L5 = a
            elif imm == 6;
                L6 = a
            elif imm == 7;
                L7 = a
            else;
                p#write(locals, imm, a)
            break
        elif op == OP_ADD;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                tos = tos + a
            else;
                sp = sp - 1
                tos = p#read(stack, sp) + a
                has = 1
            break
        elif op == OP_JNZ;
            imm = xc[ip]
            ip = ip + 1
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if a != 0;
                ip = imm
            break
        elif op == OP_JZ;
            imm = xc[ip]
            ip = ip + 1
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if a == 0;
                ip = imm
            break
        elif op == OP_JMP;
            ip = xc[ip]
        elif op == OP_SUB;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                tos = tos - a
            else;
                sp = sp - 1
                tos = p#read(stack, sp) - a
                has = 1
            break
        elif op == OP_LT;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                b = tos
            else;
                sp = sp - 1
                b = p#read(stack, sp)
            break
            if b < a;
                tos = 1
            else;
                tos = 0
            break
            has = 1
        elif op == OP_LE;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                b = tos
            else;
                sp = sp - 1
                b = p#read(stack, sp)
            break
            if b < a;
                tos = 1
            elif b == a;
                tos = 1
            else;
                tos = 0
            break
            has = 1
        elif op == OP_GT;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                b = tos
            else;
                sp = sp - 1
                b = p#read(stack, sp)
            break
            if b > a;
                tos = 1
            else;
                tos = 0
            break
            has = 1
        elif op == OP_GE;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                b = tos
            else;
                sp = sp - 1
                b = p#read(stack, sp)
            break
            if b > a;
                tos = 1
            elif b == a;
                tos = 1
            else;
                tos = 0
            break
            has = 1
        elif op == OP_EQ;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                b = tos
            else;
                sp = sp - 1
                b = p#read(stack, sp)
            break
            if b == a;
                tos = 1
            else;
                tos = 0
            break
            has = 1
        elif op == OP_NE;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                b = tos
            else;
                sp = sp - 1
                b = p#read(stack, sp)
            break
            if b != a;
                tos = 1
            else;
                tos = 0
            break
            has = 1
        elif op == OP_DUP;
            if sp + has < 1;
                err_rt("underflow de pila (dup): se necesita al menos 1 valor.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            elif sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (dup): limite de " + STACK_MAX + " valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 0;
                    tos = p#read(stack, sp - 1)
                    has = 1
                else;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                break
            break
        elif op == OP_POP;
            if sp + has < 1;
                err_rt("underflow de pila (pop): pila vacia.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            elif has == 1;
                has = 0
            else;
                sp = sp - 1
            break
        elif op == OP_MUL;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                tos = tos * a
            else;
                sp = sp - 1
                tos = p#read(stack, sp) * a
                has = 1
            break
        elif op == OP_PRINT;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            log a
        elif op == OP_PRINTS;
            if has == 1;
                a = tos
                has = 0
            elif sp < 1;
                err_rt("prints: pila vacia", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if status == 0;
                if a < 0;
                    err_rt("prints: indice invalido", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                elif a >= str_count;
                    err_rt("prints: indice fuera de rango", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                else;
                    log strpool[a]
                break
            break
        elif op == OP_PUSHS;
            imm = xc[ip]
            ip = ip + 1
            if sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (pushs)", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                break
                tos = imm
                has = 1
            break
        elif op == OP_INPUT;
            imm = xc[ip]
            ip = ip + 1
            text prompt = ""
            if imm >= 0;
                if imm < str_count;
                    prompt = strpool[imm]
                break
            break
            text ans = input prompt prompt
            numeric sid = intern_str(ans)
            if sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (input)", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                break
                tos = sid
                has = 1
            break
        elif op == OP_INPUTN;
            imm = xc[ip]
            ip = ip + 1
            text promptn = ""
            if imm >= 0;
                if imm < str_count;
                    promptn = strpool[imm]
                break
            break
            numeric numv = input prompt promptn as numeric
            if sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (inputn)", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                break
                tos = numv
                has = 1
            break
        elif op == OP_HALT;
            status = 0
            ip = cl0
        elif op == OP_IMUL_LL;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            if a == 0;
                if b == 0;
                    L0 = L0 * L0
                elif b == 1;
                    L0 = L0 * L1
                elif b == 2;
                    L0 = L0 * L2
                elif b == 3;
                    L0 = L0 * L3
                else;
                    L0 = L0 * p#read(locals, b)
                break
            elif a == 1;
                if b == 0;
                    L1 = L1 * L0
                elif b == 1;
                    L1 = L1 * L1
                else;
                    L1 = L1 * p#read(locals, b)
                break
            else;
                p#write(locals, a, p#read(locals, a) * p#read(locals, b))
            break
        elif op == OP_ISUB_LL;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            if a == 0;
                if b == 1;
                    L0 = L0 - L1
                else;
                    L0 = L0 - p#read(locals, b)
                break
            elif a == 1;
                if b == 0;
                    L1 = L1 - L0
                else;
                    L1 = L1 - p#read(locals, b)
                break
            else;
                p#write(locals, a, p#read(locals, a) - p#read(locals, b))
            break
        elif op == OP_DEC_L;
            a = xc[ip]
            ip = ip + 1
            if a == 0;
                L0 = L0 - 1
            elif a == 1;
                L1 = L1 - 1
            elif a == 2;
                L2 = L2 - 1
            elif a == 3;
                L3 = L3 - 1
            elif a == 4;
                L4 = L4 - 1
            elif a == 5;
                L5 = L5 - 1
            elif a == 6;
                L6 = L6 - 1
            elif a == 7;
                L7 = L7 - 1
            else;
                p#write(locals, a, p#read(locals, a) - 1)
            break
        elif op == OP_IADD_LN;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            if a == 0;
                L0 = L0 + b
            elif a == 1;
                L1 = L1 + b
            elif a == 2;
                L2 = L2 + b
            elif a == 3;
                L3 = L3 + b
            else;
                p#write(locals, a, p#read(locals, a) + b)
            break
        elif op == OP_SUB_LN;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            if a == 0;
                L0 = L0 - b
            elif a == 1;
                L1 = L1 - b
            elif a == 2;
                L2 = L2 - b
            elif a == 3;
                L3 = L3 - b
            else;
                p#write(locals, a, p#read(locals, a) - b)
            break
        elif op == OP_MUL_LN;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            if a == 0;
                L0 = L0 * b
            elif a == 1;
                L1 = L1 * b
            elif a == 2;
                L2 = L2 * b
            elif a == 3;
                L3 = L3 * b
            else;
                p#write(locals, a, p#read(locals, a) * b)
            break
        elif op == OP_DIV_LN;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            if b == 0;
                err_rt("division entre cero en div_ln (divisor inmediato 0).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            elif a == 0;
                L0 = L0 / b
            elif a == 1;
                L1 = L1 / b
            else;
                p#write(locals, a, p#read(locals, a) / b)
            break
        elif op == OP_ASSERT;
            if ip >= cl0;
                err_rt("assert: bytecode truncado (falta el mensaje).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            elif sp + has < 1;
                err_rt("underflow de pila (assert): se necesita 1 valor (0 = fallo, distinto de 0 = ok).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                imm = xc[ip]
                ip = ip + 1
                if has == 1;
                    a = tos
                    has = 0
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                if a == 0;
                    text amsg = "assert fallo"
                    if imm >= 0;
                        if imm < str_count;
                            amsg = strpool[imm]
                        break
                    break
                    err_rt("ASSERT: " + amsg + "  |  El valor en la pila era 0.", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                break
            break
        elif op == OP_STRCAT;
            if sp + has < 2;
                err_rt("underflow de pila (strcat): se necesitan 2 ids de string (pushs a, pushs b, strcat).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                    has = 0
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                if has == 1;
                    b = tos
                    has = 0
                else;
                    sp = sp - 1
                    b = p#read(stack, sp)
                break
                text sa = ""
                text sb = ""
                if b >= 0;
                    if b < str_count;
                        sb = strpool[b]
                    break
                break
                if a >= 0;
                    if a < str_count;
                        sa = strpool[a]
                    break
                break
                numeric nid = intern_str(sb + sa)
                tos = nid
                has = 1
            break
        elif op == OP_STRLEN;
            if sp + has < 1;
                err_rt("underflow de pila (strlen): se necesita 1 id de string.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                    has = 1
                break
                text ss = ""
                if a >= 0;
                    if a < str_count;
                        ss = strpool[a]
                    break
                break
                tos = length(ss)
                has = 1
            break
        elif op == OP_STRCMP;
            if sp + has < 2;
                err_rt("underflow de pila (strcmp): se necesitan 2 ids de string.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                    has = 0
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                if has == 1;
                    b = tos
                else;
                    sp = sp - 1
                    b = p#read(stack, sp)
                    has = 1
                break
                text sa2 = ""
                text sb2 = ""
                if a >= 0;
                    if a < str_count;
                        sa2 = strpool[a]
                    break
                break
                if b >= 0;
                    if b < str_count;
                        sb2 = strpool[b]
                    break
                break
                if sa2 == sb2;
                    tos = 0
                else;
                    tos = 1
                break
                has = 1
            break
        elif op == OP_NEWARR;
            imm = xc[ip]
            ip = ip + 1
            list narr = []
            numeric ai = 0
            while ai < imm;
                narr.append(0)
                ai = ai + 1
            break
            arr_pool.append(narr)
            numeric aid = arr_count
            arr_count = arr_count + 1
            if has == 1;
                p#write(stack, sp, tos)
                sp = sp + 1
            break
            tos = aid
            has = 1
        elif op == OP_ALOAD;
            if sp + has < 2;
                err_rt("underflow de pila (aload): se necesitan indice y handle (push idx, push arr, aload).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                    has = 0
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                if has == 1;
                    b = tos
                else;
                    sp = sp - 1
                    b = p#read(stack, sp)
                    has = 1
                break
                if a < 0;
                    err_rt("aload: handle de array invalido (" + a + "). Crea el array con newarr N antes. Uso: push idx, push arr, aload.", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                elif a >= arr_count;
                    err_rt("aload: handle de array fuera de rango (" + a + ", solo hay " + arr_count + ").", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                else;
                    list ar = arr_pool[a]
                    if b < 0;
                        err_rt("aload: indice negativo (" + b + ").", at, sp + has, fp, csp)
                        status = 1
                        ip = cl0
                    elif b >= length(ar);
                        err_rt("aload: indice " + b + " fuera de rango (length=" + length(ar) + ").", at, sp + has, fp, csp)
                        status = 1
                        ip = cl0
                    else;
                        tos = ar[b]
                        has = 1
                    break
                break
            break
        elif op == OP_ASTORE;
            if sp + has < 3;
                err_rt("underflow de pila (astore): se necesitan valor, indice y handle.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                    has = 0
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                if has == 1;
                    b = tos
                    has = 0
                else;
                    sp = sp - 1
                    b = p#read(stack, sp)
                break
                if has == 1;
                    c = tos
                    has = 0
                else;
                    sp = sp - 1
                    c = p#read(stack, sp)
                break
                if a < 0;
                    err_rt("astore: handle de array invalido (" + a + "). Uso: push val, push idx, push arr, astore.", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                elif a >= arr_count;
                    err_rt("astore: handle fuera de rango (" + a + ", solo hay " + arr_count + ").", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                else;
                    list ar2 = arr_pool[a]
                    if b < 0;
                        err_rt("astore: indice negativo (" + b + ").", at, sp + has, fp, csp)
                        status = 1
                        ip = cl0
                    elif b >= length(ar2);
                        err_rt("astore: indice " + b + " fuera de rango (length=" + length(ar2) + ").", at, sp + has, fp, csp)
                        status = 1
                        ip = cl0
                    else;
                        ar2[b] = c
                        arr_pool[a] = ar2
                    break
                break
            break
        elif op == OP_FOPEN;
            if ip >= cl0;
                err_rt("fopen: bytecode truncado (falta la ruta).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                imm = xc[ip]
                ip = ip + 1
                text fpath = ""
                if imm >= 0;
                    if imm < str_count;
                        fpath = strpool[imm]
                    break
                break
                if length(fpath) == 0;
                    err_rt("fopen: ruta vacia. Usa fopen \"archivo.txt\".", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                elif file_exists(fpath) == false;
                    err_rt("fopen: no existe el archivo '" + fpath + "'.", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                else;
                    file ff = open(fpath)
                    file_pool.append(ff)
                    numeric fid = file_count
                    file_count = file_count + 1
                    if has == 1;
                        p#write(stack, sp, tos)
                        sp = sp + 1
                    break
                    tos = fid
                    has = 1
                break
            break
        elif op == OP_FREADLN;
            if sp + has < 1;
                err_rt("underflow de pila (freadln): se necesita un handle de archivo.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                    has = 1
                break
                if a < 0;
                    err_rt("freadln: handle de archivo invalido (" + a + "). Abre antes con fopen.", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                elif a >= file_count;
                    err_rt("freadln: handle fuera de rango (" + a + ").", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                else;
                    file ffr = file_pool[a]
                    text line = read_line(ffr)
                    tos = intern_str(line)
                    has = 1
                break
            break
        elif op == OP_FWRITE;
            if sp + has < 2;
                err_rt("underflow de pila (fwrite): se necesitan id de string y handle.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                    has = 0
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                if has == 1;
                    b = tos
                    has = 0
                else;
                    sp = sp - 1
                    b = p#read(stack, sp)
                break
                text ws = ""
                if a >= 0;
                    if a < str_count;
                        ws = strpool[a]
                    break
                break
                if b >= 0;
                    if b < file_count;
                        file ffw = file_pool[b]
                        write(ffw, ws)
                    break
                break
            break
        elif op == OP_FCLOSE;
            if sp + has < 1;
                err_rt("underflow de pila (fclose): se necesita un handle de archivo.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                    has = 0
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                if a >= 0;
                    if a < file_count;
                        file ffc = file_pool[a]
                        close(ffc)
                    break
                break
            break
        elif op == OP_EXEC;
            if sp + has < 1;
                err_rt("underflow de pila (exec): se necesita un string (comando).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                    has = 0
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                text cmd = ""
                if a >= 0;
                    if a < str_count;
                        cmd = strpool[a]
                    break
                break
                if length(cmd) == 0;
                    err_rt("exec: comando vacio o id de string invalido.", at, sp + has, fp, csp)
                    status = 1
                    ip = cl0
                else;
                    numeric rc = exec(cmd)
                    tos = rc
                    has = 1
                break
            break
        elif op == OP_ITOA;
            if sp + has < 1;
                err_rt("underflow de pila (itoa): se necesita 1 numero.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                    has = 1
                break
                tos = intern_str("" + a)
                has = 1
            break
        elif op == OP_ATOI;
            if sp + has < 1;
                err_rt("underflow de pila (atoi): se necesita 1 id de string.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    a = tos
                else;
                    sp = sp - 1
                    a = p#read(stack, sp)
                    has = 1
                break
                text ss = ""
                if a >= 0;
                    if a < str_count;
                        ss = strpool[a]
                    break
                break
                text cleaned = ""
                numeric pi = 0
                numeric sn = length(ss)
                numeric started = 0
                while pi < sn;
                    text cx = ss[pi]
                    if started == 0;
                        if cx == " ";
                            pi = pi + 1
                        elif cx == "-";
                            cleaned = cleaned + cx
                            started = 1
                            pi = pi + 1
                        elif cx == "+";
                            started = 1
                            pi = pi + 1
                        else;
                            started = 1
                        break
                    else;
                        if cx == "0";
                            cleaned = cleaned + cx
                        elif cx == "1";
                            cleaned = cleaned + cx
                        elif cx == "2";
                            cleaned = cleaned + cx
                        elif cx == "3";
                            cleaned = cleaned + cx
                        elif cx == "4";
                            cleaned = cleaned + cx
                        elif cx == "5";
                            cleaned = cleaned + cx
                        elif cx == "6";
                            cleaned = cleaned + cx
                        elif cx == "7";
                            cleaned = cleaned + cx
                        elif cx == "8";
                            cleaned = cleaned + cx
                        elif cx == "9";
                            cleaned = cleaned + cx
                        else;
                            pi = sn
                        break
                        pi = pi + 1
                    break
                break
                if is_number_token(cleaned);
                    tos = parse_num(cleaned)
                else;
                    tos = 0
                break
                has = 1
            break
        elif op == OP_JGT_LN;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            imm = xc[ip]
            ip = ip + 1
            c = 0
            if a == 0;
                c = L0
            elif a == 1;
                c = L1
            elif a == 2;
                c = L2
            elif a == 3;
                c = L3
            else;
                c = p#read(locals, a)
            break
            if c > b;
                ip = imm
            break
        elif op == OP_JLT_LN;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            imm = xc[ip]
            ip = ip + 1
            c = 0
            if a == 0;
                c = L0
            elif a == 1;
                c = L1
            else;
                c = p#read(locals, a)
            break
            if c < b;
                ip = imm
            break
        elif op == OP_JGE_LN;
            a = xc[ip]
            ip = ip + 1
            b = xc[ip]
            ip = ip + 1
            imm = xc[ip]
            ip = ip + 1
            c = 0
            if a == 0;
                c = L0
            elif a == 1;
                c = L1
            else;
                c = p#read(locals, a)
            break
            if c > b;
                ip = imm
            elif c == b;
                ip = imm
            break
        elif op == OP_JZ_L;
            a = xc[ip]
            ip = ip + 1
            imm = xc[ip]
            ip = ip + 1
            c = 0
            if a == 0;
                c = L0
            elif a == 1;
                c = L1
            else;
                c = p#read(locals, a)
            break
            if c == 0;
                ip = imm
            break
        elif op == OP_JNZ_L;
            a = xc[ip]
            ip = ip + 1
            imm = xc[ip]
            ip = ip + 1
            c = 0
            if a == 0;
                c = L0
            elif a == 1;
                c = L1
            else;
                c = p#read(locals, a)
            break
            if c != 0;
                ip = imm
            break
        elif op == OP_CALL;
            imm = xc[ip]
            ip = ip + 1
            if csp >= CALL_MAX;
                err_rt("demasiadas llamadas anidadas. Suele ser recursion sin fin o un call sin ret/return.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                    has = 0
                break
                p#write(cstack_ip, csp, ip)
                p#write(cstack_fp, csp, fp)
                csp = csp + 1
                fp = sp
                ip = imm
            break
        elif op == OP_RET;
            if csp <= 0;
                status = 0
                ip = cl0
            else;
                a = 0
                if has == 1;
                    a = tos
                    has = 0
                    if sp > fp;
                    break
                elif sp > fp;
                    sp = sp - 1
                    a = p#read(stack, sp)
                break
                csp = csp - 1
                ip = p#read(cstack_ip, csp)
                fp = p#read(cstack_fp, csp)
                sp = fp
                tos = a
                has = 1
            break
        elif op == OP_DIV;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                b = tos
            else;
                sp = sp - 1
                b = p#read(stack, sp)
            break
            if a == 0;
                err_rt("division entre cero (el divisor en la pila era 0). Haz push de un divisor distinto de 0 antes de div.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                tos = b / a
                has = 1
            break
        elif op == OP_MOD;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                b = tos
            else;
                sp = sp - 1
                b = p#read(stack, sp)
            break
            if a == 0;
                err_rt("modulo entre cero (divisor 0 en la pila). Revisa el push anterior a mod.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                tos = b % a
                has = 1
            break
        elif op == OP_NEG;
            if sp + has < 1;
                err_rt("underflow de pila (neg).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            elif has == 1;
                tos = 0 - tos
            else;
                p#write(stack, sp - 1, 0 - p#read(stack, sp - 1))
            break
        elif op == OP_NOT;
            if sp + has < 1;
                err_rt("underflow de pila (not).", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 0;
                    tos = p#read(stack, sp - 1)
                    sp = sp - 1
                    has = 1
                break
                if tos == 0;
                    tos = 1
                else;
                    tos = 0
                break
            break
        elif op == OP_AND;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                tos = tos & a
            else;
                sp = sp - 1
                tos = p#read(stack, sp) & a
                has = 1
            break
        elif op == OP_OR;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                tos = tos | a
            else;
                sp = sp - 1
                tos = p#read(stack, sp) | a
                has = 1
            break
        elif op == OP_XOR;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                tos = tos ^ a
            else;
                sp = sp - 1
                tos = p#read(stack, sp) ^ a
                has = 1
            break
        elif op == OP_SHL;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                tos = tos << a
            else;
                sp = sp - 1
                tos = p#read(stack, sp) << a
                has = 1
            break
        elif op == OP_SHR;
            if has == 1;
                a = tos
                has = 0
            else;
                sp = sp - 1
                a = p#read(stack, sp)
            break
            if has == 1;
                tos = tos >> a
            else;
                sp = sp - 1
                tos = p#read(stack, sp) >> a
                has = 1
            break
        elif op == OP_SWAP;
            if sp + has < 2;
                err_rt("underflow de pila (swap): se necesitan 2 valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            elif has == 1;
                a = tos
                sp = sp - 1
                tos = p#read(stack, sp)
                p#write(stack, sp, a)
                sp = sp + 1
            else;
                a = p#read(stack, sp - 1)
                b = p#read(stack, sp - 2)
                p#write(stack, sp - 1, b)
                p#write(stack, sp - 2, a)
            break
        elif op == OP_OVER;
            if sp + has < 2;
                err_rt("underflow de pila (over): se necesitan 2 valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            elif sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (over): limite de " + STACK_MAX + " valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                    tos = p#read(stack, sp - 2)
                else;
                    tos = p#read(stack, sp - 2)
                    has = 1
                break
            break
        elif op == OP_ROT;
            if sp + has < 3;
                err_rt("underflow de pila (rot): se necesitan 3 valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            elif has == 1;
                a = tos
                b = p#read(stack, sp - 1)
                c = p#read(stack, sp - 2)
                p#write(stack, sp - 2, b)
                p#write(stack, sp - 1, a)
                tos = c
            else;
                a = p#read(stack, sp - 1)
                b = p#read(stack, sp - 2)
                c = p#read(stack, sp - 3)
                p#write(stack, sp - 3, b)
                p#write(stack, sp - 2, a)
                p#write(stack, sp - 1, c)
            break
        elif op == OP_DUMP;
            dump_stack(sp, tos, has)
        elif op == OP_ARGC;
            if sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (argc): limite de " + STACK_MAX + " valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                break
                tos = argc()
                has = 1
            break
        elif op == OP_ARG;
            imm = xc[ip]
            ip = ip + 1
            text targ = arg(imm)
            a = 0
            if is_number_token(targ);
                a = parse_num(targ)
            break
            if sp + has >= STACK_MAX;
                err_rt("desbordamiento de pila (arg): limite de " + STACK_MAX + " valores.", at, sp + has, fp, csp)
                status = 1
                ip = cl0
            else;
                if has == 1;
                    p#write(stack, sp, tos)
                    sp = sp + 1
                break
                tos = a
                has = 1
            break
        elif op == OP_HALTC;
            if has == 1;
                last_exit = tos
                has = 0
            elif sp > 0;
                sp = sp - 1
                last_exit = p#read(stack, sp)
            break
            status = 0
            ip = cl0
        break
    break

    if show_stats == 1;
        log ""
        log "--- stats ---"
        log "pasos: " + steps
        log "slots: " + code_len
        log "sp: " + (sp + has)
        log "exit: " + last_exit
    break
    return status
break

fun op_name -> text numeric op;
    if op == OP_HALT;
        return "halt"
    elif op == OP_PUSH;
        return "push"
    elif op == OP_POP;
        return "pop"
    elif op == OP_DUP;
        return "dup"
    elif op == OP_SWAP;
        return "swap"
    elif op == OP_OVER;
        return "over"
    elif op == OP_ROT;
        return "rot"
    elif op == OP_ADD;
        return "add"
    elif op == OP_SUB;
        return "sub"
    elif op == OP_MUL;
        return "mul"
    elif op == OP_DIV;
        return "div"
    elif op == OP_MOD;
        return "mod"
    elif op == OP_NEG;
        return "neg"
    elif op == OP_NOT;
        return "not"
    elif op == OP_AND;
        return "and"
    elif op == OP_OR;
        return "or"
    elif op == OP_XOR;
        return "xor"
    elif op == OP_SHL;
        return "shl"
    elif op == OP_SHR;
        return "shr"
    elif op == OP_EQ;
        return "eq"
    elif op == OP_NE;
        return "ne"
    elif op == OP_LT;
        return "lt"
    elif op == OP_LE;
        return "le"
    elif op == OP_GT;
        return "gt"
    elif op == OP_GE;
        return "ge"
    elif op == OP_JMP;
        return "jmp"
    elif op == OP_JZ;
        return "jz"
    elif op == OP_JNZ;
        return "jnz"
    elif op == OP_LOAD;
        return "load"
    elif op == OP_STORE;
        return "store"
    elif op == OP_CALL;
        return "call"
    elif op == OP_RET;
        return "ret"
    elif op == OP_PRINT;
        return "print"
    elif op == OP_PUSHS;
        return "pushs"
    elif op == OP_PRINTS;
        return "prints"
    elif op == OP_INPUT;
        return "input"
    elif op == OP_INPUTN;
        return "inputn"
    elif op == OP_DUMP;
        return "dump"
    elif op == OP_ARGC;
        return "argc"
    elif op == OP_ARG;
        return "arg"
    elif op == OP_HALTC;
        return "haltc"
    elif op == OP_IADD_LL;
        return "iadd_ll"
    elif op == OP_IMUL_LL;
        return "imul_ll"
    elif op == OP_ISUB_LL;
        return "isub_ll"
    elif op == OP_INC_L;
        return "inc_l"
    elif op == OP_DEC_L;
        return "dec_l"
    elif op == OP_IADD_LN;
        return "iadd_ln"
    elif op == OP_JLE_LN;
        return "jle_ln"
    elif op == OP_JGT_LN;
        return "jgt_ln"
    elif op == OP_JLT_LN;
        return "jlt_ln"
    elif op == OP_JGE_LN;
        return "jge_ln"
    elif op == OP_JZ_L;
        return "jz_l"
    elif op == OP_JNZ_L;
        return "jnz_l"
    elif op == OP_ASSERT;
        return "assert"
    elif op == OP_SUB_LN;
        return "sub_ln"
    elif op == OP_MUL_LN;
        return "mul_ln"
    elif op == OP_DIV_LN;
        return "div_ln"
    elif op == OP_STRCAT;
        return "strcat"
    elif op == OP_STRLEN;
        return "strlen"
    elif op == OP_SLICE;
        return "slice"
    elif op == OP_STRCMP;
        return "strcmp"
    elif op == OP_NEWARR;
        return "newarr"
    elif op == OP_ALOAD;
        return "aload"
    elif op == OP_ASTORE;
        return "astore"
    elif op == OP_FOPEN;
        return "fopen"
    elif op == OP_FREADLN;
        return "freadln"
    elif op == OP_FWRITE;
        return "fwrite"
    elif op == OP_FCLOSE;
        return "fclose"
    elif op == OP_EXEC;
        return "exec"
    elif op == OP_ITOA;
        return "itoa"
    elif op == OP_ATOI;
        return "atoi"
    break
    return "?"
break

fun disassemble -> bool;
    numeric i = 0
    while i < code_len;
        numeric op = p#read(code, i)
        numeric ln = p#read(codeline, i)
        text line = "" + i + "  " + op_name(op)
        if needs_arg(op);
            line = line + " " + p#read(code, i + 1)
            i = i + 1
        break
        if ln > 0;
            line = line + "    ; L" + ln
        break
        log line
        i = i + 1
    break
    return true
break

fun cmd_help -> bool;
    log "Pegassus 1.9.12 — VM de pila (stack/locals 1MiB c/u) / IR optimizer / asm"
    log "  native/build: subconjunto via pegbin; semántica completa = interpretador"
    log ""
    log "Uso:"
    log "  pegassus [flags] <comando> <prog.ir>"
    log "  pegassus [flags] <prog.ir>              (equivale a run)"
    log ""
    log "Optimizacion IR:"
    log "  (defecto) / --normal / -O0     peephole (fusiones de bucle)"
    log "  --medium / -O1                rondas genericas + limpieza"
    log "  --aggressive / -O2            mas rondas + load-fwd / dead-store"
    log "  --bare / -Obare / -O3         maximo + fuse_inc_jle"
    log ""
    log "Flags extra:"
    log "  --steps N                     limite de pasos (gas)"
    log "  --linux | --windows | --macos  destino de asm (defecto linux)"
    log ""
    log "Comandos:"
    log "  run check dis opt asm build native test fmt repl trace stats clean"
    log "  examples cmds version help"
    log ""
    log "Ejemplos:"
    log "  pegassus run prog.ir"
    log "  pegassus --bare run prog.ir"
    log "  pegassus --bare opt prog.ir"
    log "  pegassus --bare --linux asm prog.ir"
    log "  pegassus test prog.ir"
    log "  pegassus --steps 1000000 run prog.ir"
    log ""
    log "IR (resumen):"
    log "  const NAME N | lab name | include otro.ir"
    log "  push N | load S | store S | jmp/jz/jnz L | call L | ret"
    log "  add sub mul div mod | and or xor | eq lt le ... | print | end"
    log "  ; comentario"
    return true
break

fun cmd_cmds -> bool;
    log "run stats check dis opt asm fmt repl clean examples cmds version help"
    log "const lab push pop dup swap over rot"
    log "add sub mul div mod neg and or xor shl shr not"
    log "eq ne lt le gt ge jmp jz jnz call ret return"
    log "load store print pushs prints input inputn dump argc arg halt end"
    log "assert strcat strlen slice strcmp newarr aload astore"
    log "fopen freadln fwrite fclose exec system itoa atoi"
    return true

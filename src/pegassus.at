fun opcode_width -> numeric numeric op;
    if op == OP_PUSH;
        return 1
    elif op == OP_JMP;
        return 1
    elif op == OP_JZ;
        return 1
    elif op == OP_JNZ;
        return 1
    elif op == OP_LOAD;
        return 1
    elif op == OP_STORE;
        return 1
    elif op == OP_CALL;
        return 1
    elif op == OP_ARG;
        return 1
    elif op == OP_PUSHS;
        return 1
    elif op == OP_INPUT;
        return 1
    elif op == OP_INPUTN;
        return 1
    elif op == OP_IADD_LL;
        return 2
    elif op == OP_IMUL_LL;
        return 2
    elif op == OP_ISUB_LL;
        return 2
    elif op == OP_INC_L;
        return 1
    elif op == OP_DEC_L;
        return 1
    elif op == OP_IADD_LN;
        return 2
    elif op == OP_JLE_LN;
        return 3
    elif op == OP_JGT_LN;
        return 3
    elif op == OP_JLT_LN;
        return 3
    elif op == OP_JGE_LN;
        return 3
    elif op == OP_JZ_L;
        return 2
    elif op == OP_JNZ_L;
        return 2
    elif op == OP_SUB_LN;
        return 2
    elif op == OP_MUL_LN;
        return 2
    elif op == OP_DIV_LN;
        return 2
    elif op == OP_ASSERT;
        return 1
    elif op == OP_NEWARR;
        return 1
    elif op == OP_FOPEN;
        return 1
    break
    if is_valid_opcode(op);
        return 0
    break
    return 0 - 1
break

